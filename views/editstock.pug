doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Edit Stock - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      body {
        background-color: #0f172a;
        color: white;
        min-height: 100vh;
        font-family: sans-serif;
        padding: 40px;
      }

      .edit-card {
        background: white;
        color: #0f172a;
        border-radius: 14px;
        padding: 30px;
        max-width: 1100px;
        margin: auto;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      }

      .page-title {
        font-weight: 800;
        border-bottom: 3px solid #f97316;
        padding-bottom: 10px;
        margin-bottom: 30px;
        display: inline-block;
      }

      .form-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #475569;
      }

      .form-control,
      .form-select {
        border-radius: 8px;
        padding: 10px;
      }

      .btn-update {
        background-color: #0f172a;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        transition: 0.3s;
      }

      .btn-update:hover {
        background-color: #1e293b;
        color: #f97316;
      }

      .btn-cancel {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        text-align: center;
      }

  body

    .container

      .edit-card

        h3.page-title
          i.bi.bi-pencil-square.me-2
          | Edit Stock Item

        form(action='/update-stock/' + stock._id method='POST')

          .row.g-3

            .col-md-3
              label.form-label Product Name

              select.form-select(name='productname' required)

                option(value=stock.productname selected)
                  = stock.productname

                option(value='Cement iiN') Cement iiN
                option(value='Cement iiiN') Cement iiiN
                option(value='Iron Bars 10mm') Iron Bars 10mm
                option(value='Iron Bars 12mm') Iron Bars 12mm
                option(value='Iron Bars 16mm') Iron Bars 16mm
                option(value='Nails 1 Inch') Nails 1 Inch
                option(value='Nails 2 Inch') Nails 2 Inch
                option(value='Nails 3 Inch') Nails 3 Inch
                option(value='Nails 4 Inch') Nails 4 Inch
                option(value='Nails 5 Inch') Nails 5 Inch
                option(value='Wheelbarrows') Wheelbarrows
                option(value='Wire Mesh') Wire Mesh
                option(value='Barbed Wire') Barbed Wire
                option(value='Iron Sheets') Iron Sheets

            .col-md-3
              label.form-label Quantity

              input.form-control(
                type='number'
                name='quantity'
                value=stock.quantity
                required
              )

            .col-md-3
              label.form-label Unit Cost (UGX)

              input.form-control(
                type='number'
                name='unitcost'
                value=stock.unitcost
                required
              )

            .col-md-3
              label.form-label Selling Price

              input.form-control(
                type='number'
                name='sellingprice'
                value=stock.sellingprice
                required
              )

            .col-md-3
              label.form-label Supplier Name

              input.form-control(
                type='text'
                name='suppliername'
                value=stock.suppliername
                required
              )

            .col-md-3
              label.form-label Supplier Phone

              input.form-control(
                type='text'
                name='supplierphone'
                value=stock.supplierphone
                required
              )

            .col-md-3
              label.form-label Factory Name

              input.form-control(
                type='text'
                name='factoryname'
                value=stock.factoryname
                required
              )

            .col-md-3
              label.form-label Payment Status

              select.form-select(
                name='paymentstatus'
                required
              )

                option(value=stock.paymentstatus selected)
                  = stock.paymentstatus

                option(value='Cash At Hand') Cash At Hand
                option(value='Mobile Money') Mobile Money
                option(value='Credit') Credit

            .col-12.mt-4
              .d-flex.gap-3

                button.btn-update.w-100(type='submit')
                  i.bi.bi-save.me-2
                  | Save Changes

                a.btn-cancel.w-100(href='/stock')
                  i.bi.bi-x-circle.me-2
                  | Cancel