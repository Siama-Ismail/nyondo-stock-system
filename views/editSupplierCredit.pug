doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Edit Supplier Credit - NYONDO HARDWARE
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .form-label {
        font-weight: 600;
        color: var(--color-charcoal);
        font-size: 14px;
      }

      .form-control {
        border-radius: 8px;
        padding: 10px;
      }

      .form-control:focus {
        border-color: var(--color-teal);
        box-shadow: none;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background: var(--color-teal);
        color: white;
        border: none;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }

  body

    .container.py-5

      .card.p-5.mx-auto(style='max-width:700px')

        h3.fw-bold.mb-4 Edit Supplier Credit

        form(
          action='/update-supplier-credit/' + credit._id
          method='post'
        )

          .mb-3
            label.form-label Supplier Name
            input.form-control(
              type='text'
              name='supplierName'
              value=credit.supplierName
              required
            )

          .mb-3
            label.form-label Phone
            input.form-control(
              type='text'
              name='supplierPhone'
              value=credit.supplierPhone
              required
            )

          .mb-3
            label.form-label Item
            input.form-control(
              type='text'
              name='item'
              value=credit.item
              required
            )

          .mb-3
            label.form-label Quantity
            input.form-control(
              type='number'
              name='quantity'
              value=credit.quantity
              required
            )

          .mb-3
            label.form-label Unit Price
            input.form-control(
              type='number'
              name='unitPrice'
              value=credit.unitPrice
              required
            )

          .mb-3
            label.form-label Paid
            input.form-control(
              type='number'
              name='paid'
              value=credit.paid
              required
            )

          button.btn.btn-nyondo.w-100.mt-4(type='submit') Save Changes