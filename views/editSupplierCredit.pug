doctype html
html
  head
    title Edit Supplier Credit
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
    )

  body.bg-light

    .container.mt-4

      .card
        .card-header Edit Supplier Credit

        .card-body

          form(
            action='/update-supplier-credit/' + credit._id
            method='post'
          )

            .mb-3
              label Supplier Name
              input.form-control(
                type='text'
                name='supplierName'
                value=credit.supplierName
              )

            .mb-3
              label Phone
              input.form-control(
                type='text'
                name='supplierPhone'
                value=credit.supplierPhone
              )

            .mb-3
              label Item
              input.form-control(
                type='text'
                name='item'
                value=credit.item
              )

            .mb-3
              label Quantity
              input.form-control(
                type='number'
                name='quantity'
                value=credit.quantity
              )

            .mb-3
              label Unit Price
              input.form-control(
                type='number'
                name='unitPrice'
                value=credit.unitPrice
              )

            .mb-3
              label Paid
              input.form-control(
                type='number'
                name='paid'
                value=credit.paid
              )

            button.btn.btn-primary Save Changes