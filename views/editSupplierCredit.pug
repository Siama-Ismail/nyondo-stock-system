doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Edit Supplier Credit - NYONDO HARDWARE
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .form-label {
        font-weight: 600;
        color: var(--color-charcoal);
        font-size: 14px;
      }

      .form-control {
        border-radius: 8px;
        padding: 10px;
      }

      .form-control:valid {
        background-image: none !important;
      }
      .form-control:invalid {
        border-color: #dc3545 !important;
        box-shadow: none !important;
      }
      .form-control:invalid:focus {
        box-shadow: none !important;
      }
      .was-validated .form-control:invalid {
        border-color: #dc3545 !important;
      }
      .form-control:valid,
      .form-control:valid:focus {
        border-color: #ced4da !important;
        box-shadow: none !important;
      }

      .form-control:focus {
        border-color: var(--color-teal);
        box-shadow: none;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background: var(--color-teal);
        color: white;
        border: none;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }

  body

    .container.py-5

      .card.p-5.mx-auto(style='max-width:700px')

        h3.fw-bold.mb-4 Edit Supplier Credit

        form(
          action='/update-supplier-credit/' + credit._id
          method='post'
          novalidate
        )

          .mb-3
            label.form-label Supplier Name
            input.form-control(
              type='text'
              name='supplierName'
              value=(oldData && oldData.supplierName ? oldData.supplierName : credit.supplierName)
              required
            )
            .invalid-feedback
              if fieldErrors && fieldErrors.supplierName
                = fieldErrors.supplierName
              else
                | Supplier name is required.

          .mb-3
            label.form-label Phone
            input.form-control(
              type="tel" 
              name="supplierPhone" 
              id="customerPhoneInput" 
              value=(oldData && oldData.supplierPhone ? oldData.supplierPhone : (credit && credit.supplierPhone ? credit.supplierPhone : '+256')) 
              maxlength="13" 
              pattern="^\\+256[0-9]{9}$" 
              title="Phone number must start with +256 followed by exactly 9 digits"
              class=(fieldErrors && fieldErrors.supplierPhone? 'is-invalid' : '')
              required
              )
            .invalid-feedback
              if fieldErrors && fieldErrors.supplierPhone
                = fieldErrors.supplierPhone
              else
                | Enter a valid Ugandan phone number.

          .mb-3
            label.form-label Item
            input.form-control(
              type='text'
              name='item'
              value=(oldData && oldData.item ? oldData.item : credit.item)
              required
            )
            .invalid-feedback
              if fieldErrors && fieldErrors.item
                = fieldErrors.item
              else
                | Item description is required.

          .mb-3
            label.form-label Quantity
            input.form-control(
              type='number'
              name='quantity'
              value=(oldData && oldData.quantity ? oldData.quantity : credit.quantity)
              required
            )
            .invalid-feedback
              if fieldErrors && fieldErrors.quantity
                = fieldErrors.quantity
              else
                | Enter a valid quantity.

          .mb-3
            label.form-label Unit Price
            input.form-control(
              type='number'
              name='unitPrice'
              value=(oldData && oldData.unitPrice ? oldData.unitPrice : credit.unitPrice)
              required
            )
            .invalid-feedback
              if fieldErrors && fieldErrors.unitPrice
                = fieldErrors.unitPrice
              else
                | Enter a valid unit price.

          .mb-3
            label.form-label Paid
            input.form-control(
              type='number'
              name='paid'
              value=(oldData && typeof oldData.paid !== 'undefined' ? oldData.paid : credit.paid)
              required
            )
            .invalid-feedback
              if fieldErrors && fieldErrors.paid
                = fieldErrors.paid
              else
                | Enter a valid paid amount.

          button.btn.btn-nyondo.w-100.mt-4(type='submit') Save Changes

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script.
      const editCreditForm = document.querySelector('form[action^="/update-supplier-credit/"]');
      if (editCreditForm) {
        editCreditForm.addEventListener('submit', function (event) {
          if (!editCreditForm.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          editCreditForm.classList.add('was-validated');
        }, false);
      }