doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Suppliers - NYONDO General Hardware LTD

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --matte-black: #111827;
        --emerald-green: #10B981;
        --silver-bg: #E5E7EB;
        --dark-slate: #1f2937;
        --sidebar-width: 260px;
      }

      body {
        background-color: var(--silver-bg);
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--matte-black);
      }

      #sidebar {
        width: var(--sidebar-width);
        height: 100vh;
        position: fixed;
        background-color: var(--matte-black);
        color: white;
        border-right: 4px solid var(--emerald-green);
      }

      .sidebar-header {
        padding: 25px 20px;
        font-weight: 800;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        text-transform: uppercase;
      }

      .sidebar-header span {
        color: var(--emerald-green);
      }

      .nav-link {
        color: rgba(255,255,255,0.7);
        padding: 15px 20px;
      }

      .nav-link:hover {
        color: var(--emerald-green);
        background: var(--dark-slate);
      }

      .nav-link.active {
        color: white;
        background: var(--dark-slate);
        border-left: 4px solid var(--emerald-green);
      }

      #content {
        margin-left: var(--sidebar-width);
        padding: 40px;
      }

      .st-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #ddd;
        border-left: 5px solid var(--emerald-green);
        padding: 18px;
        transition: 0.3s;
      }

      .st-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
      }

      .badge-status-active {
        background: rgba(16,185,129,0.15);
        color: #065f46;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 12px;
      }

      .badge-status-inactive {
        background: rgba(220,53,69,0.15);
        color: #842029;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 12px;
      }

      .badge-status-pending {
        background: rgba(255,193,7,0.15);
        color: #664d03;
        padding: 4px 10px;
        border-radius: 50px;
        font-size: 12px;
      }

  body

    // SIDEBAR
    nav#sidebar
      .sidebar-header
        | NYONDO
        span  STOCK

      ul.nav.flex-column.mt-3
        li.nav-item
          a.nav-link(href='/admin')
            i.bi.bi-speedometer2.me-2
            | Dashboard

        li.nav-item
          a.nav-link.active(href='/suppliers')
            i.bi.bi-boxes.me-2
            | Suppliers


    // CONTENT
    #content

      .d-flex.justify-content-between.align-items-center.mb-4
        h2.fw-bold
          i.bi.bi-boxes.me-2
          | Supplier Management

        button.btn.btn-dark(
          data-bs-toggle='modal'
          data-bs-target='#addSupplierModal'
        )
          i.bi.bi-plus-circle.me-2
          | Add Supplier


      // =========================
      // SUPPLIERS GRID
      // =========================
      if suppliers.length === 0

        .alert.alert-info.text-center
          | No suppliers found

      else

        .row.g-4

          each supplier in suppliers

            .col-md-4

              .st-card

                .d-flex.justify-content-between.align-items-center
                  h5.fw-bold.mb-1= supplier.supplierName

                  if supplier.status === 'active'
                    span.badge-status-active Active
                  else if supplier.status === 'inactive'
                    span.badge-status-inactive Inactive
                  else
                    span.badge-status-pending Pending

                small.text-muted
                  | #{supplier.contactPerson} • #{supplier.phoneNumber}

                hr

                h6 Products Supplied

                if supplier.productsSupplied.length > 0
                  .d-flex.flex-wrap.gap-1.mb-2
                    each item in supplier.productsSupplied
                      span.badge.bg-light.text-dark.border
                        | #{item}
                else
                  small.text-muted No products listed

                // LOW STOCK ALERT
                if supplier.lowStockItems && supplier.lowStockItems.length > 0

                  .alert.alert-danger.p-2.mt-2
                    strong ⚠ Low Stock Items

                    ul.mb-0.mt-2
                      each item in supplier.lowStockItems
                        li
                          | #{item.productname}
                          span.text-danger.fw-bold
                            |  (#{item.quantity})

                else
                  .alert.alert-success.p-2.mt-2
                    | All items in good stock


                .d-flex.justify-content-between.mt-3

                  a.btn.btn-sm.btn-outline-primary(
                    href='/edit-supplier/' + supplier._id
                  )
                    i.bi.bi-pencil.me-1
                    | Edit

                  a.btn.btn-sm.btn-outline-danger(
                    href='/delete-supplier/' + supplier._id
                    onclick="return confirm('Delete supplier?')"
                  )
                    i.bi.bi-trash.me-1
                    | Delete


    // =========================
    // ADD SUPPLIER MODAL
    // =========================
    #addSupplierModal.modal.fade

      .modal-dialog.modal-lg.modal-dialog-centered

        .modal-content

          .modal-header.bg-dark.text-white
            h5.modal-title Add Supplier

            button.btn-close.btn-close-white(
              data-bs-dismiss='modal'
            )

          .modal-body

            form(action='/add-supplier' method='POST')

              .mb-2
                input.form-control(name='supplierName' placeholder='Supplier Name' required)

              .mb-2
                input.form-control(name='contactPerson' placeholder='Contact Person' required)

              .mb-2
                input.form-control(name='phoneNumber' placeholder='Phone Number' required)

              .mb-2
                input.form-control(name='emailAddress' placeholder='Email')

              .mb-2
                input.form-control(name='supplierAddress' placeholder='Address')

              .mb-2
                input.form-control(name='productsSupplied' placeholder='Products (comma separated)')

              .mb-2
                select.form-control(name='status')
                  option(value='active') Active
                  option(value='inactive') Inactive
                  option(value='pending') Pending

              button.btn.btn-dark.w-100.mt-2(type='submit')
                | Save Supplier