doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Suppliers - NYONDO General Hardware LTD

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --matte-black: #1e2229;       
        --brand-teal: #0a9387;     
        --silver-bg: #f4f6f8;         
      }

      body {
        background-color: var(--silver-bg);
        margin: 0;
        font-family: sans-serif;
        color: var(--matte-black);
      }

      #sidebar {
        width: 260px;
        height: 100vh;
        position: fixed;
        background-color: var(--matte-black);
        border-right: 3px solid var(--brand-teal);
      }

      .sidebar-header {
        padding: 25px 20px;
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--brand-teal);
      }

      .nav-link {
        color: rgba(255,255,255,0.7);
        padding: 12px 20px;
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .nav-link:hover, .nav-link.active {
        color: var(--brand-teal) !important;
        background: rgba(10, 147, 135, 0.1);
      }

      #content {
        margin-left: 260px;
        padding: 40px;
      }

      .st-card {
        background: white;
        border-radius: 12px;
        border: 1px solid #dee2e6;
        padding: 20px;
      }

      .btn-teal {
        background-color: var(--brand-teal);
        color: #ffffff;
        border: none;
        font-weight: 700;
      }

      .btn-teal:hover {
        background-color: #08776d;
        color: #ffffff;
      }

      .btn-outline-teal {
        color: var(--brand-teal);
        border-color: var(--brand-teal);
        background: transparent;
      }

      .btn-outline-teal:hover {
        background-color: var(--brand-teal);
        color: #ffffff;
      }

  body

    // SIDEBAR
    nav#sidebar
      .sidebar-header NYONDO STOCK

      ul.nav.flex-column.mt-2
        li.nav-item
          a.nav-link(href='/admin')
            i.bi.bi-speedometer2.me-2
            span Dashboard
        li.nav-item
          a.nav-link.active(href='/suppliers')
            i.bi.bi-boxes.me-2
            span Suppliers
        li.nav-item
          a.nav-link(href='/logout')
            i.bi.bi-box-arrow-right.me-2.text-danger
            span Logout

    // CONTENT WORKSPACE
    #content

      .d-flex.justify-content-between.align-items-center.mb-4
        h2.fw-bold.mb-0 Supplier Management

        button.btn.btn-teal.px-4(
          data-bs-toggle='modal'
          data-bs-target='#addSupplierModal'
        )
          i.bi.bi-plus-circle.me-2
          | Add Supplier

      // SUPPLIERS GRID
      if !suppliers || suppliers.length === 0
        .alert.alert-info.text-center No suppliers found
      else
        .row.g-4
          each supplier in suppliers
            .col-md-4
              .st-card
                .d-flex.justify-content-between.align-items-center.mb-2
                  h5.fw-bold.mb-0= supplier.supplierName
                  
                  //- AUTOMATED PERFORMANCE STATUS BADGE
                  if supplier.lowStockItems && supplier.lowStockItems.length > 0
                    span.badge.bg-danger.text-capitalize Critical Performance
                  else
                    span.badge.bg-success.text-capitalize Excellent Performance

                div.mb-3
                  small.text-muted #{supplier.contactPerson} • #{supplier.phoneNumber}

                hr

                h6.fw-bold.small.text-uppercase Products Supplied
                if supplier.productsSupplied && supplier.productsSupplied.length > 0
                  .d-flex.flex-wrap.gap-1.mb-3
                    each item in supplier.productsSupplied
                      span.badge.bg-light.text-dark.border= item
                else
                  p.small.text-muted.mb-3 No products listed

                // Stock monitoring alert setup
                if supplier.lowStockItems && supplier.lowStockItems.length > 0
                  .alert.alert-danger.p-2.mb-3.small
                    strong ⚠ Low Stock Items
                    ul.mb-0.mt-1.ps-3
                      each item in supplier.lowStockItems
                        li #{item.productname} (#{item.quantity})
                else
                  .alert.alert-light.p-2.mb-3.small.text-muted.border
                    i.bi.bi-check-circle-fill.me-1.text-success
                    | Stock levels normal

                .d-flex.gap-2.mt-3
                  a.btn.btn-sm.btn-outline-teal.w-50(href='/edit-supplier/' + supplier._id) Edit
                  a.btn.btn-sm.btn-outline-danger.w-50(
                    href='/delete-supplier/' + supplier._id
                    onclick="return confirm('Delete supplier?')"
                  ) Delete

    // ADD SUPPLIER MODAL (Cleaned Up - Status Input Removed)
    #addSupplierModal.modal.fade
      .modal-dialog.modal-md.modal-dialog-centered
        .modal-content(style="border-radius: 12px; overflow: hidden;")
          .modal-header.text-white(style="background-color: var(--matte-black);")
            h5.modal-title.fw-bold Add Supplier
            button.btn-close.btn-close-white(data-bs-dismiss='modal')

          .modal-body.p-4
            form(action='/add-supplier' method='POST' novalidate)
              .mb-3
                label.form-label Supplier Name
                input.form-control(name='supplierName' required)
              .mb-3
                label.form-label Contact Person
                input.form-control(name='contactPerson' required)
              .mb-3
                label.form-label Phone Number
                input.form-control(
                  type="tel" 
                  name="phoneNumber" 
                  id="supplierPhoneInput" 
                  value=(oldData && oldData.phoneNumber ? oldData.phoneNumber : "+256") 
                  maxlength="13" 
                  pattern="^\\+256[0-9]{9}$" 
                  title="Phone number must start with +256 followed by exactly 9 digits"
                  class=(errors && errors.supplierContact ? 'is-invalid' : '')
                  required
                )
              .mb-3
                label.form-label Email Address
                input.form-control(type='email' name='emailAddress')
              .mb-3
                label.form-label Address
                input.form-control(name='supplierAddress')
              .mb-4
                label.form-label Products (comma separated)
                input.form-control(name='productsSupplied')

              button.btn.btn-teal.w-100.py-2.fw-bold(type='submit') Save Supplier

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script.
      // Fetch the form and apply custom Bootstrap validation styles on submit
      const form = document.querySelector('form[action="/add-supplier"]');
      if (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      }