doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Deposit Money - NYONDO HARDWARE

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        color: var(--color-charcoal);
        font-family: sans-serif;
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .btn-nyondo {
        background: var(--color-teal);
        color: white;
        border: none;
        font-weight: 700;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }
      
      .balance-review-card {
        background-color: transparent;
        border: 1px solid var(--color-charcoal);
      }

      .st-sidebar {
        width: 260px;
        height: 100vh;
        background-color: #212529;
        border-right: 3px solid #0d9488;
        position: fixed;
        top: 0;
        left: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        z-index: 1000;
      }

      .st-sidebar .navbar-brand {
        font-size: 1.5rem;
        text-decoration: none;
        color: white;
        font-weight: 800;
        margin-bottom: 30px;
      }

      .st-sidebar .navbar-brand span { color: #0d9488; }

      .st-sidebar .nav-link {
        color: #caecf5;
        opacity: 0.85;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: 0.3s;
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .st-sidebar .nav-link:hover,
      .st-sidebar .nav-link.active {
        background-color: rgba(13, 148, 136, 0.15);
        color: #ffffff !important;
        opacity: 1;
      }

      .st-sidebar .nav-link.active {
        border-left: 4px solid #0d9488;
        border-radius: 0 8px 8px 0;
      }

      .main-content {
        margin-left: 260px;
        width: calc(100% - 260px);
        padding: 40px;
      }

  body
    .st-sidebar
      a.navbar-brand(href='/admin')
        | NYONDO
        span STOCK

      nav.nav.flex-column
        a.nav-link(href='/admin')
          i.bi.bi-speedometer2.me-2
          span Dashboard
        a.nav-link.active(href='/credit')
          i.bi.bi-cash-stack.me-2
          span Credit
        a.nav-link(href='/stock')
          i.bi.bi-box-seam.me-2
          span Inventory
        a.nav-link(href='/manage-stock')
          i.bi.bi-journal-text.me-2
          span Ledger
        a.nav-link(href='/logout')
          i.bi.bi-box-arrow-right.me-2.text-danger
          span Logout

    .main-content
      .container.py-5

      .card.p-5.mx-auto(style='max-width:700px')

        h2.mb-4.fw-bold.text-uppercase Deposit Payment

        .alert.alert-secondary
          strong Customer:
          |  #{customer.fullName}

        .alert.alert-secondary
          strong Total Account Balance:
          |  UGX #{customer.balance.toLocaleString()}

        
        // CLEAR EXISTING BALANCE
        
        if pendingDeposits.length > 0

          .card.p-3.mb-4.balance-review-card

            h5.fw-bold.mb-3 Clear Existing Balance

            form(
              action='/add-deposit/' + customer._id
              method='POST'
            )

              .mb-3

                label.form-label Select Pending Item

                select.form-select(
                  name='depositId'
                  required
                )

                  option(value='') -- Select Pending Invoice --

                  each dep in pendingDeposits

                    option(
                      value=dep._id
                    )
                      | #{dep.item}
                      |  - Remaining: UGX #{dep.balance.toLocaleString()}

              .mb-3

                label.form-label Amount Paying

                input.form-control(
                  type='number'
                  name='amount'
                  required
                )

              .mb-3

                label.form-label Payment Method

                select.form-select(
                  name='paymentMethod'
                  required
                )

                  option(value='Cash') Cash
                  option(value='Mobile Money') Mobile Money
                  option(value='Bank') Bank

              button.btn.btn-dark.w-100(
                type='submit'
              ) Clear Balance

        hr.my-5

        
        // NEW CREDIT SALE
        
        h5.fw-bold.mb-4 Add New Credit Sale

        form(
          action='/add-deposit/' + customer._id
          method='POST'
        )

          .mb-3

            label.form-label Select Item

            select.form-select(
              name='item'
              required
            )

              option(value='') -- Select Product --

              each stock in stocks

                option(
                  value=stock.productname || stock.productName
                )
                  | #{stock.productname || stock.productName}
                  |  - Stock: #{stock.quantity}
                  |  - UGX #{stock.sellingPrice.toLocaleString()}

          .mb-3

            label.form-label Quantity

            input.form-control(
              type='number'
              name='quantity'
              min='1'
              required
            )

          .mb-3

            label.form-label Amount Paid

            input.form-control(
              type='number'
              name='amount'
              value='0'
              required
            )

          .mb-3

            label.form-label Payment Method

            select.form-select(
              name='paymentMethod'
              required
            )

              option(value='Cash') Cash
              option(value='Mobile Money') Mobile Money
              option(value='Bank') Bank

          button.btn.btn-nyondo.w-100.mt-4(
            type='submit'
          ) Save Credit Sale