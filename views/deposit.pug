doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Deposit Money - NYONDO HARDWARE

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    style.
      :root {
        --primary-navy: #111827;
        --accent-orange: #FD7E14;
        --light-bg: #E5E7EB;
      }

      body {
        background: var(--light-bg);
        color: var(--primary-navy);
        font-family: sans-serif;
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .btn-nyondo {
        background: var(--accent-orange);
        color: white;
        border: none;
        font-weight: 700;
      }

  body

    .container.py-5

      .card.p-5.mx-auto(style='max-width:700px')

        h2.mb-4.fw-bold.text-uppercase Deposit Payment

        .alert.alert-secondary
          strong Customer:
          |  #{customer.fullName}

        .alert.alert-warning
          strong Total Account Balance:
          |  UGX #{customer.balance.toLocaleString()}

        // ============================
        // CLEAR EXISTING BALANCE
        // ============================
        if pendingDeposits.length > 0

          .card.p-3.mb-4(style='background:#fff7ed')

            h5.fw-bold.mb-3.text-warning Clear Existing Balance

            form(
              action='/add-deposit/' + customer._id
              method='POST'
            )

              .mb-3

                label.form-label Select Pending Item

                select.form-select(
                  name='depositId'
                  required
                )

                  option(value='') -- Select Pending Invoice --

                  each dep in pendingDeposits

                    option(
                      value=dep._id
                    )
                      | #{dep.item}
                      |  - Remaining: UGX #{dep.balance.toLocaleString()}

              .mb-3

                label.form-label Amount Paying

                input.form-control(
                  type='number'
                  name='amount'
                  required
                )

              .mb-3

                label.form-label Payment Method

                select.form-select(
                  name='paymentMethod'
                  required
                )

                  option(value='Cash') Cash
                  option(value='Mobile Money') Mobile Money
                  option(value='Bank') Bank

              button.btn.btn-warning.w-100(
                type='submit'
              ) Clear Balance

        hr.my-5

        // ============================
        // NEW CREDIT SALE
        // ============================
        h5.fw-bold.mb-4 Add New Credit Sale

        form(
          action='/add-deposit/' + customer._id
          method='POST'
        )

          .mb-3

            label.form-label Select Item

            select.form-select(
              name='item'
              required
            )

              option(value='') -- Select Product --

              each stock in stocks

                option(
                  value=stock.productname || stock.productName
                )
                  | #{stock.productname || stock.productName}
                  |  - Stock: #{stock.quantity}
                  |  - UGX #{stock.sellingPrice.toLocaleString()}

          .mb-3

            label.form-label Quantity

            input.form-control(
              type='number'
              name='quantity'
              min='1'
              required
            )

          .mb-3

            label.form-label Amount Paid

            input.form-control(
              type='number'
              name='amount'
              value='0'
              required
            )

          .mb-3

            label.form-label Payment Method

            select.form-select(
              name='paymentMethod'
              required
            )

              option(value='Cash') Cash
              option(value='Mobile Money') Mobile Money
              option(value='Bank') Bank

          button.btn.btn-nyondo.w-100.mt-4(
            type='submit'
          ) Save Credit Sale