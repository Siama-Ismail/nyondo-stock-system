doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Supplier Credit

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
    )

  body.bg-light

    .container.mt-4

      h2.mb-4 Supplier Credit Management

      // =========================
      // SUMMARY CARD
      // =========================
      .card.mb-4.shadow-sm

        .card-body

          h4.text-danger
            | Total Supplier Debt:
            |  UGX #{Number(totalDebt).toLocaleString()}

      // =========================
      // ADD CREDIT FORM
      // =========================
      .card.mb-4.shadow-sm

        .card-header.bg-dark.text-white
          h5.mb-0 Add Supplier Credit

        .card-body

          form(action='/add-supplier-credit' method='post')

            .row.g-3

              .col-md-3
                label.form-label Supplier Name
                input.form-control(
                  type='text'
                  name='supplierName'
                  required
                )

              .col-md-3
                label.form-label Phone Number
                input.form-control(
                  type='text'
                  name='supplierPhone'
                  required
                )

              .col-md-2
                label.form-label Item
                input.form-control(
                  type='text'
                  name='item'
                  required
                )

              .col-md-2
                label.form-label Quantity
                input.form-control(
                  type='number'
                  name='quantity'
                  required
                )

              .col-md-2
                label.form-label Unit Price
                input.form-control(
                  type='number'
                  name='unitPrice'
                  required
                )

              .col-md-2
                label.form-label Paid
                input.form-control(
                  type='number'
                  name='paid'
                  value='0'
                )

            button.btn.btn-dark.mt-4(type='submit')
              | Add Credit

      // =========================
      // CREDIT TABLE
      // =========================
      .card.shadow-sm

        .card-header.bg-primary.text-white
          h5.mb-0 Supplier Credit Records

        .card-body.table-responsive

          table.table.table-bordered.table-hover.align-middle

            thead.table-dark

              tr
                th Supplier
                th Phone
                th Item
                th Qty
                th Unit Price
                th Amount
                th Paid
                th Balance
                th Status
                th Actions

            tbody

              if credits.length > 0

                each c in credits

                  tr

                    td= c.supplierName
                    td= c.supplierPhone
                    td= c.item

                    td= c.quantity

                    td
                      | UGX #{Number(c.unitPrice).toLocaleString()}

                    td
                      | UGX #{Number(c.amount).toLocaleString()}

                    td
                      | UGX #{Number(c.paid).toLocaleString()}

                    td.text-danger
                      | UGX #{Number(c.balance).toLocaleString()}

                    td

                      if c.status === 'PAID'

                        span.badge.bg-success PAID

                      else

                        span.badge.bg-warning.text-dark UNPAID

                    td

                      a.btn.btn-sm.btn-primary.mb-1(
                        href='/edit-supplier-credit/' + c._id
                      )
                        | Edit

                      form(
                        action='/pay-supplier/' + c._id
                        method='post'
                        class='mb-1'
                      )

                        input.form-control.form-control-sm.mb-1(
                          type='number'
                          name='paid'
                          placeholder='Pay Amount'
                          required
                        )

                        button.btn.btn-sm.btn-success.w-100(
                          type='submit'
                        )
                          | Pay

                      a.btn.btn-sm.btn-danger(
                        href='/delete-supplier-credit/' + c._id
                        onclick="return confirm('Delete this record?')"
                      )
                        | Delete

              else

                tr

                  td.text-center(colspan='10')
                    | No supplier credit records found.