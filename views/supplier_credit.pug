doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Supplier Credit - NYONDO STOCK

    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')

    style.
      body { 
        background-color: #f4f6f8; 
        color: #111827; 
        min-height: 100vh; 
        margin: 0; 
        font-family: sans-serif; 
        overflow-x: hidden; 
      }
      /* Sidebar styling matched to image */
      .st-sidebar { 
        width: 260px; 
        height: 100vh; 
        background-color: #1e2229; 
        border-right: 3px solid #0a9387; 
        position: fixed; 
        top: 0; 
        left: 0; 
        padding: 20px; 
        display: flex; 
        flex-direction: column; 
        z-index: 1000; 
      }
      .st-sidebar .navbar-brand { 
        font-size: 1.5rem; 
        text-decoration: none; 
        color: #0a9387; 
        font-weight: 800; 
        margin-bottom: 30px; 
      }
      .st-sidebar .nav-link { 
        color: rgba(255,255,255,0.7); 
        padding: 12px 15px; 
        border-radius: 8px; 
        margin-bottom: 8px; 
        transition: 0.3s; 
        display: flex; 
        align-items: center; 
        text-decoration: none; 
      }
      .st-sidebar .nav-link:hover, .st-sidebar .nav-link.active { 
        background-color: rgba(10,147,135,0.1); 
        color: #0a9387 !important; 
      }
      /* Content Pane */
      .main-content { 
        margin-left: 260px; 
        width: calc(100% - 260px); 
        padding: 40px; 
      }
      .st-main-h { 
        font-weight: 800; 
        margin-bottom: 30px; 
        color: #111827; 
      }
      .st-card-style { 
        background: #ffffff; 
        color: #111827; 
        border-radius: 12px; 
        border: none; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.03); 
        overflow: hidden; 
        border: 1px solid #dee2e6; 
      }
      .st-accent-text { 
        color: #111827; 
        font-weight: 700; 
        border-bottom: 2px solid #0a9387; 
        padding-bottom: 10px; 
        margin-bottom: 20px; 
        display: inline-block; 
      }
      /* Accurate Active Buttons to match form submission */
      .st-btn-accent { 
        background-color: #0a9387; 
        color: #ffffff; 
        border: none; 
        font-weight: 700; 
        transition: 0.3s; 
        padding: 12px; 
        border-radius: 8px; 
      }
      .st-btn-accent:hover { 
        background-color: #08776d; 
        color: #ffffff; 
      }
      .stat-card-dark { 
        background-color: #1e2229; 
        color: white; 
        border-radius: 12px; 
        border: none;
      }
      .form-label { 
        font-size: 0.85rem; 
        font-weight: 600; 
        color: #64748b; 
      }
      .form-control:valid {
        background-image: none !important;
      }
      .form-control:invalid {
        border-color: #dc3545 !important;
        box-shadow: none !important;
      }
      .form-control:invalid:focus {
        box-shadow: none !important;
      }
      .was-validated .form-control:invalid {
        border-color: #dc3545 !important;
      }
      .form-control:valid,
      .form-control:valid:focus {
        border-color: #ced4da !important;
        box-shadow: none !important;
      }
      .table { 
        font-size: 0.85rem; 
        vertical-align: middle; 
      }

      .alert {
        border-radius: 12px;
      }

  body
    // SIDEBAR
    .st-sidebar
      a.navbar-brand(href='/dashboard')
        span NYONDO STOCK

      nav.nav.flex-column
        a.nav-link(href='/dashboard')
          i.bi.bi-speedometer2.me-2
          span Dashboard

        a.nav-link.active(href='/supplier-credit')
          i.bi.bi-tags.me-2
          span Supplier Credit

        a.nav-link(href='/logout')
          i.bi.bi-box-arrow-right.me-2.text-danger
          span Logout

    // MAIN CONTENT
    .main-content
      h2.st-main-h Supplier Credit Management

      if success && success.length
        .alert.alert-success.mt-3.mb-3= success[0]
      if error && error.length
        .alert.alert-danger.mt-3.mb-3= error[0]

      // SUMMARY CARD (Matches top display card blocks)
      .row.mb-4
        .col-md-4.mb-3
          .card.stat-card-dark.p-3
            h6.small.text-uppercase(style="color: #ef4444;") Total Supplier Debt
            h4.fw-bold.mb-0 UGX #{Number(totalDebt).toLocaleString()}

      // ADD CREDIT FORM
      .row.mb-4
        .col-12
          .card.st-card-style.p-4
            h5.st-accent-text Add Supplier Credit

            form(action='/add-supplier-credit' method='post' novalidate class='needs-validation')
              .row.g-3
                .col-md-3
                  label.form-label Supplier Name
                  input.form-control(type='text' name='supplierName' required value=(oldData && oldData.supplierName ? oldData.supplierName : ''))
                  .invalid-feedback
                    if fieldErrors && fieldErrors.supplierName
                      = fieldErrors.supplierName
                    else
                      | Supplier name is required.

                .col-md-3
                  label.form-label Phone Number
                  input.form-control(
                type="tel" 
                name="supplierPhone" 
                id="customerPhoneInput" 
                placeholder="+256700000000"
                value=(oldData && oldData.supplierPhone ? oldData.supplierPhone : '+256')
                minlength="13"
                maxlength="13" 
                pattern="^\\+256[0-9]{9}$" 
                title="Phone number must start with +256 followed by exactly 9 digits (e.g. +256772123456)"
                required
              )
                  .invalid-feedback
                    if fieldErrors && fieldErrors.supplierPhone
                      = fieldErrors.supplierPhone
                    else
                      | Enter a valid Ugandan phone number.
                .col-md-2
                  label.form-label Item
                  input.form-control(type='text' name='item' required value=(oldData && oldData.item ? oldData.item : ''))
                  .invalid-feedback
                    if fieldErrors && fieldErrors.item
                      = fieldErrors.item
                    else
                      | Item description is required.

                .col-md-2
                  label.form-label Quantity
                  input.form-control(type='number' name='quantity' min='1' required value=(oldData && oldData.quantity ? oldData.quantity : ''))
                  .invalid-feedback
                    if fieldErrors && fieldErrors.quantity
                      = fieldErrors.quantity
                    else
                      | Enter a valid quantity (minimum 1).

                .col-md-2
                  label.form-label Unit Price
                  input.form-control(type='number' name='unitPrice' min='0' required value=(oldData && oldData.unitPrice ? oldData.unitPrice : ''))
                  .invalid-feedback
                    if fieldErrors && fieldErrors.unitPrice
                      = fieldErrors.unitPrice
                    else
                      | Enter a valid unit price.

                .col-md-2
                  label.form-label Paid
                  input.form-control(type='number' name='paid' value=(oldData && typeof oldData.paid !== 'undefined' ? oldData.paid : '') min='0' required placeholder='0')
                  .invalid-feedback
                    if fieldErrors && fieldErrors.paid
                      = fieldErrors.paid
                    else
                      | Enter paid amount or 0 if none

              .col-12.mt-4
                button.st-btn-accent.w-100(type='submit')
                  i.bi.bi-plus-circle.me-2
                  | Add Credit Record

      // CREDIT TABLE
      .row
        .col-12
          .card.st-card-style.p-4
            h5.st-accent-text Supplier Credit Records

            .table-responsive
              table.table.table-hover.align-middle
                thead
                  tr.text-uppercase.text-secondary
                    th Supplier
                    th Phone
                    th Item
                    th Qty
                    th Unit Price
                    th Amount
                    th Paid
                    th Balance
                    th Status
                    th Actions

                tbody
                  if credits && credits.length > 0
                    each c in credits
                      tr
                        td.fw-bold= c.supplierName
                        td= c.supplierPhone
                        td= c.item
                        td= c.quantity
                        td UGX #{Number(c.unitPrice).toLocaleString()}
                        td.fw-semibold UGX #{Number(c.amount).toLocaleString()}
                        td.text-success UGX #{Number(c.paid).toLocaleString()}
                        td.text-danger.fw-bold UGX #{Number(c.balance).toLocaleString()}

                        td
                          if c.status === 'PAID'
                            span.badge.bg-success PAID
                          else
                            span.badge.bg-warning.text-dark UNPAID

                        td
                          .d-flex.flex-column.gap-2
                            a.btn.btn-sm.btn-outline-dark(href='/edit-supplier-credit/' + c._id)
                              i.bi.bi-pencil.me-1
                              | Edit

                            form(action='/pay-supplier/' + c._id method='post' class='m-0 needs-validation' novalidate)
                              .input-group.input-group-sm
                                input.form-control(type='number' name='paid' placeholder='Amount' min='1' required)
                                .invalid-feedback
                                  | Enter an amount to pay (minimum 1).
                                button.btn.st-btn-accent(type='submit' style='padding: 0 12px; border-radius: 0 4px 4px 0;') Pay

                            a.btn.btn-sm.btn-danger(
                              href='/delete-supplier-credit/' + c._id
                              onclick="return confirm('Delete this record?')"
                            )
                              i.bi.bi-trash.me-1
                              | Delete
                  else
                    tr
                      td.text-center.text-muted(colspan='10') No supplier credit records found.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script.
      const forms = document.querySelectorAll('.needs-validation');
      Array.from(forms).forEach(function (form) {
        form.addEventListener('submit', function (event) {
          if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });