doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Admin Dashboard - NYONDO Stock General Hardware LTD

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --matte-black: #111827;
        --emerald-green: #10B981;
        --silver-bg: #E5E7EB;
        --dark-slate: #1f2937;
      }

      body {
        background-color: var(--silver-bg);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--matte-black);
      }

      .sidebar {
        background: var(--matte-black);
        min-height: 100vh;
        color: white;
        border-right: 4px solid var(--emerald-green);
      }

      .sidebar .nav-link {
        color: rgba(255,255,255,0.8);
        margin-bottom: 5px;
        font-weight: 500;
        transition: 0.3s;
      }

      .sidebar .nav-link:hover {
        background: var(--dark-slate);
        color: var(--emerald-green);
      }

      .sidebar .nav-link.active {
        background: var(--dark-slate);
        border-left: 4px solid var(--emerald-green);
        color: white;
      }

      /* Premium Uniform Metrics Cards */
      .brand-card {
        background-color: var(--matte-black) !important;
        color: white !important;
        border: none;
        border-bottom: 4px solid var(--emerald-green);
        border-radius: 12px;
        transition: 0.3s;
        height: 100%; 
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .brand-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(17,24,39,0.2);
      }

      /* Premium Quick Action list elements */
      .btn-quick-action {
        background-color: var(--matte-black);
        color: white;
        border: 1px solid rgba(255,255,255,0.1);
        text-align: left;
        transition: 0.2s;
        font-weight: 500;
      }

      .btn-quick-action:hover {
        background-color: var(--emerald-green);
        color: var(--matte-black);
        border-color: var(--emerald-green);
        font-weight: 600;
      }

      .navbar {
        background: var(--matte-black);
        border-bottom: 2px solid var(--emerald-green);
      }

      .navbar-brand {
        font-weight: 800;
        letter-spacing: 1px;
      }

      .navbar-brand span {
        color: var(--emerald-green);
      }

      .card {
        border: 1px solid #d1d5db;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        border-radius: 10px;
        background-color: #ffffff;
      }

      .card-header.bg-dark {
        background-color: var(--matte-black) !important;
        border-bottom: 2px solid var(--emerald-green);
      }

      .table-hover tbody tr:hover {
        background-color: rgba(16,185,129,0.08);
      }

      .metric-highlight {
        font-weight: 700;
      }

  body

    // NAVBAR
    nav.navbar.navbar-expand-lg.navbar-dark
      .container-fluid

        a.navbar-brand(href='/admin')
          i.bi.bi-house-gear.me-2
          | NYONDO STOCK GENERAL 
          span HARDWARE

        button.navbar-toggler(
          type='button'
          data-bs-toggle='collapse'
          data-bs-target='#navbarNav'
        )
          span.navbar-toggler-icon

        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto

            li.nav-item
              a.nav-link(href='/admin')
                i.bi.bi-bell

            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(
                href='#'
                role='button'
                data-bs-toggle='dropdown'
              )
                i.bi.bi-person-circle.me-1
                | Admin

              ul.dropdown-menu.dropdown-menu-end

                li: a.dropdown-item(href='/admin') Dashboard
                li: a.dropdown-item(href='/stock') Inventory
                li: a.dropdown-item(href='/sales') Sales
                li: a.dropdown-item(href='/credit') Credit Scheme
                li: a.dropdown-item(href='/suppliers') Suppliers
                li: hr.dropdown-divider
                li: a.dropdown-item.text-danger(href='/logout') Logout


    // MAIN LAYOUT
    .container-fluid
      .row

        // SIDEBAR
        .col-md-2.sidebar.p-0

          .text-center.py-4
            h4.fw-bold
              | NYONDO 
              span(style='color: var(--emerald-green);') STOCK

          ul.nav.flex-column.px-3

            li.nav-item
              a.nav-link.active(href='/admin')
                i.bi.bi-speedometer2.me-2
                | Admin Dashboard 

            li.nav-item
              a.nav-link(href='/stock')
                i.bi.bi-box-seam.me-2
                | Inventory

            li.nav-item
              a.nav-link(href='/sales')
                i.bi.bi-receipt.me-2
                | Sales

            li.nav-item
              a.nav-link(href='/credit')
                i.bi.bi-credit-card.me-2
                | Credit Scheme

            li.nav-item
              a.nav-link(href='/suppliers')
                i.bi.bi-people.me-2
                | Suppliers 

            li.nav-item.mt-4
              a.nav-link.text-danger(href='/logout')
                i.bi.bi-box-arrow-right.me-2
                | Logout


        // MAIN CONTENT
        .col-md-10.p-4

          .d-flex.justify-content-between.align-items-center.mb-4

            h2.fw-bold(style='color: var(--matte-black);') Admin Dashboard

            .alert.alert-info.mb-0.py-2.border-0.shadow-sm(
              style='background-color: white; color: var(--matte-black); border-left: 4px solid var(--emerald-green) !important;'
            )
              i.bi.bi-calendar-check.me-2(style='color: var(--emerald-green);')
              | Today: 
              span#current-date.fw-semibold


          // FIRST LINE OF CARDS (UNIFORM SIZE)
          .row.mb-4.g-4

            .col-md-3
              .card.brand-card.shadow
                .card-body
                  .d-flex.justify-content-between
                    div
                      h6.text-uppercase.small.opacity-75 Total Stock Items
                      h2.mb-0= totalStockItems
                    i.bi.bi-box-seam.display-4.opacity-50(style='color: var(--emerald-green);')
                  .mt-3
                    a.text-white.small.text-decoration-none(href='/stock') View Details →

            .col-md-3
              .card.brand-card.shadow
                .card-body
                  .d-flex.justify-content-between
                    div
                      h6.text-uppercase.small.opacity-75 Total Sales
                      h2.mb-0 UGX #{Number(totalSales).toLocaleString()}
                    i.bi.bi-graph-up-arrow.display-4.opacity-50(style='color: var(--emerald-green);')
                  .mt-3
                    a.text-white.small.text-decoration-none(href='/sales') View Details →

            .col-md-3
              .card.brand-card.shadow
                .card-body
                  .d-flex.justify-content-between
                    div
                      h6.text-uppercase.small.opacity-75 Credit Balance
                      h2.mb-0 UGX #{Number(totalCredit).toLocaleString()}
                    i.bi.bi-credit-card.display-4.opacity-50(style='color: var(--emerald-green);')
                  .mt-3
                    a.text-white.small.text-decoration-none(href='/credit') View Details →

            .col-md-3
              .card.brand-card.shadow
                .card-body
                  .d-flex.justify-content-between
                    div
                      h6.text-uppercase.small.opacity-75 Low Stock Alerts
                      h2.mb-0= lowStock.length
                    i.bi.bi-exclamation-triangle.display-4.opacity-50.text-danger
                  .mt-3
                    a.text-white.small.text-decoration-none(href='/stock') View Details →


          // REPORTS SECTION 
          .row.mb-4
            .col-12
              .card
                .card-header.bg-dark.text-white
                  h5.mb-0 Business Reports
                .card-body
                  .row.g-4
                    .col-md-3
                      .border.rounded.p-3.h-100(style='border-color: #d1d5db !important;')
                        h6.fw-bold.text-muted Inventory Value
                        h4.metric-highlight(style='color: var(--matte-black);') UGX #{Number(inventoryValue).toLocaleString()}
                    .col-md-3
                      .border.rounded.p-3.h-100(style='border-color: #d1d5db !important;')
                        h6.fw-bold.text-muted Sales Revenue
                        h4.text-success.metric-highlight UGX #{Number(totalSales).toLocaleString()}
                    .col-md-3
                      .border.rounded.p-3.h-100(style='border-color: #d1d5db !important;')
                        h6.fw-bold.text-muted Credit Outstanding
                        h4.text-warning.metric-highlight UGX #{Number(totalCredit).toLocaleString()}
                    .col-md-3
                      .border.rounded.p-3.h-100(style='border-color: #d1d5db !important;')
                        h6.fw-bold.text-muted Low Stock Items
                        h4.text-danger.metric-highlight = lowStock.length


          // RECENT SALES
          .row
            .col-md-8
              .card
                .card-header.bg-dark.text-white
                  h5.mb-0 Recent Transactions
                .card-body
                  .table-responsive
                    table.table.table-hover.align-middle
                      thead
                        tr
                          th ID
                          th Customer
                          th Amount
                          th Status
                          th Date
                      tbody
                        if recentSales.length > 0
                          each sale in recentSales
                            tr
                              td.fw-monospace= sale._id.toString().slice(-6)
                              td.fw-semibold= sale.customerName
                              td.fw-bold UGX #{Number(sale.total).toLocaleString()}
                              td
                                if sale.paymentMethod === 'Credit'
                                  span.badge.bg-warning-subtle.text-warning.px-2.py-1 Credit
                                else
                                  span.badge.bg-success-subtle.text-success.px-2.py-1 Paid
                              td= new Date(sale.createdAt).toLocaleDateString()
                        else
                          tr
                            td.text-center.text-muted.py-4(colspan='5') No recent sales found

            // UNIFORM QUICK ACTIONS 
            .col-md-4
              .card
                .card-header.bg-dark.text-white
                  h5.mb-0 Quick Actions
                .card-body.p-3
                  a.btn.btn-quick-action.w-100.mb-3.py-3.px-3.rounded.d-block.text-decoration-none(href='/sales')
                    i.bi.bi-plus-circle.me-3
                    | New Sale
                  a.btn.btn-quick-action.w-100.mb-3.py-3.px-3.rounded.d-block.text-decoration-none(href='/stock')
                    i.bi.bi-box-arrow-in-down.me-3
                    | Receive Stock
                  a.btn.btn-quick-action.w-100.mb-3.py-3.px-3.rounded.d-block.text-decoration-none(href='/credit')
                    i.bi.bi-credit-card.me-3
                    | Credit Scheme
                  a.btn.btn-quick-action.w-100.py-3.px-3.rounded.d-block.text-decoration-none(href='/stock')
                    i.bi.bi-exclamation-triangle.me-3
                    | Low Stock Alerts

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script.
      const now = new Date();
      const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
      document.getElementById('current-date').textContent = now.toLocaleDateString('en-US', options);