doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Admin Dashboard - NYONDO General Hardware LTD

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --primary-navy: #0f172a;
        --accent-orange: #f97316;
        --action-blue: #1e40af;
        --light-bg: #f8fafc;
      }

      body {
        background-color: var(--light-bg);
        font-family: 'Segoe UI', sans-serif;
      }

      .sidebar {
        background: var(--primary-navy);
        min-height: 100vh;
        color: white;
        border-right: 4px solid var(--accent-orange);
        position: fixed;
      }

      .sidebar .nav-link {
        color: rgba(255,255,255,0.8);
        margin-bottom: 5px;
        font-weight: 500;
        transition: 0.3s;
        border-radius: 6px;
      }

      .sidebar .nav-link:hover {
        background: var(--action-blue);
        color: white;
      }

      .sidebar .nav-link.active {
        background: var(--action-blue);
        border-left: 4px solid var(--accent-orange);
        color: white;
      }

      .main-content {
        margin-left: 16.666667%;
        padding: 30px;
      }

      .card-counter {
        border-radius: 12px;
        transition: all 0.3s;
        border: none;
      }

      .card-counter:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(15,23,42,0.15);
      }

      .bg-primary {
        background-color: var(--action-blue) !important;
      }

      .bg-success {
        background-color: #10b981 !important;
      }

      .bg-warning {
        background-color: var(--accent-orange) !important;
        color: white !important;
      }

      .bg-info {
        background-color: #0ea5e9 !important;
      }

      .navbar {
        background: var(--primary-navy);
        border-bottom: 2px solid var(--accent-orange);
      }

      .navbar-brand {
        font-weight: 800;
        letter-spacing: 1px;
      }

      .navbar-brand span {
        color: var(--accent-orange);
      }

      .card {
        border: none;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        border-radius: 10px;
      }

      .card-header.bg-dark {
        background-color: var(--primary-navy) !important;
        border-bottom: 2px solid var(--accent-orange);
      }

      .btn-primary {
        background-color: var(--action-blue);
        border: none;
      }

      .btn-success {
        background-color: #10b981;
        border: none;
      }

      .btn-warning {
        background-color: var(--accent-orange);
        border: none;
        color: white;
      }

      .table-hover tbody tr:hover {
        background-color: rgba(30,64,175,0.05);
      }

      .report-card {
        border-left: 4px solid var(--accent-orange);
      }

      .quick-btn {
        font-weight: 600;
      }

      @media(max-width:768px){
        .sidebar{
          position: relative;
          min-height: auto;
        }

        .main-content{
          margin-left: 0;
        }
      }

  body

    // NAVBAR
    nav.navbar.navbar-expand-lg.navbar-dark
      .container-fluid

        a.navbar-brand(href='/dashboard')
          i.bi.bi-house-gear.me-2
          | NYONDO
          span  HARDWARE

        button.navbar-toggler(
          type='button'
          data-bs-toggle='collapse'
          data-bs-target='#navbarNav'
        )
          span.navbar-toggler-icon

        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto

            li.nav-item
              a.nav-link(href='#')
                i.bi.bi-bell

            li.nav-item.dropdown
              a.nav-link.dropdown-toggle(
                href='#'
                role='button'
                data-bs-toggle='dropdown'
              )
                i.bi.bi-person-circle.me-1
                | Admin

              ul.dropdown-menu.dropdown-menu-end
                li
                  a.dropdown-item(href='/dashboard') Dashboard

                li
                  a.dropdown-item(href='/stock') Inventory

                li
                  a.dropdown-item(href='/sales') Sales

                li
                  a.dropdown-item(href='/credit') Credit

                li
                  hr.dropdown-divider

                li
                  a.dropdown-item.text-danger(href='/logout') Logout


    // MAIN LAYOUT
    .container-fluid
      .row

        // SIDEBAR
        .col-md-2.sidebar.p-0

          .text-center.py-4
            h4.fw-bold
              | NYONDO
              span(style='color:#f97316')  STOCK

          ul.nav.flex-column.px-3

            li.nav-item
              a.nav-link.active(href='/dashboard')
                i.bi.bi-speedometer2.me-2
                | Dashboard

            li.nav-item
              a.nav-link(href='/stock')
                i.bi.bi-box-seam.me-2
                | Inventory

            li.nav-item
              a.nav-link(href='/sales')
                i.bi.bi-receipt.me-2
                | Sales

            li.nav-item
              a.nav-link(href='/credit')
                i.bi.bi-credit-card.me-2
                | Credit

            li.nav-item
              a.nav-link(href='/reports')
                i.bi.bi-bar-chart.me-2
                | Reports

            li.nav-item.mt-4
              a.nav-link.text-danger(href='/logout')
                i.bi.bi-box-arrow-right.me-2
                | Logout


        // MAIN CONTENT
        .col-md-10.main-content

          .d-flex.justify-content-between.align-items-center.mb-4

            h2.fw-bold(style='color: var(--primary-navy);')
              | Admin Dashboard

            .alert.alert-info.mb-0.py-2.border-0.shadow-sm(
              style='background-color:white; color:var(--primary-navy); border-left:4px solid var(--action-blue) !important;'
            )
              i.bi.bi-calendar-check.me-2.text-primary

              | Today:
              span#current-date.ms-1


          // SUMMARY CARDS
          .row.mb-4

            .col-md-3.mb-3
              .card.card-counter.bg-primary.text-white.shadow
                .card-body

                  .d-flex.justify-content-between
                    div
                      h6 Total Stock
                      h3 #{totalStock || 0}

                    i.bi.bi-box-seam.display-5.opacity-50

                  a.text-white.small(href='/stock')
                    | View Inventory →

            .col-md-3.mb-3
              .card.card-counter.bg-success.text-white.shadow
                .card-body

                  .d-flex.justify-content-between
                    div
                      h6 Total Sales
                      h3 UGX #{(totalSales || 0).toLocaleString()}

                    i.bi.bi-currency-dollar.display-5.opacity-50

                  a.text-white.small(href='/sales')
                    | View Sales →

            .col-md-3.mb-3
              .card.card-counter.bg-warning.text-white.shadow
                .card-body

                  .d-flex.justify-content-between
                    div
                      h6 Credit Balance
                      h3 UGX #{(creditBalance || 0).toLocaleString()}

                    i.bi.bi-credit-card.display-5.opacity-50

                  a.text-white.small(href='/credit')
                    | View Credit →

            .col-md-3.mb-3
              .card.card-counter.bg-info.text-white.shadow
                .card-body

                  .d-flex.justify-content-between
                    div
                      h6 Low Stock
                      h3 #{lowStockCount || 0}

                    i.bi.bi-exclamation-triangle.display-5.opacity-50

                  a.text-white.small(href='/stock')
                    | Check Items →


          // REPORTS SECTION
          .row.mb-4

            .col-md-8.mb-4

              .card.report-card

                .card-header.bg-dark.text-white
                  h5.mb-0
                    i.bi.bi-bar-chart-line.me-2
                    | Business Reports Summary

                .card-body

                  .table-responsive

                    table.table.table-hover

                      thead
                        tr
                          th Report
                          th Description
                          th Status

                      tbody

                        tr
                          td Daily Sales
                          td Tracks all sales made today
                          td
                            span.badge.bg-success Updated

                        tr
                          td Inventory Report
                          td Shows remaining stock quantities
                          td
                            span.badge.bg-primary Active

                        tr
                          td Credit Report
                          td Outstanding customer balances
                          td
                            span.badge.bg-warning Pending

                        tr
                          td Profit Report
                          td Calculates estimated profits
                          td
                            span.badge.bg-success Updated

                        tr
                          td Low Stock Report
                          td Displays products running low
                          td
                            span.badge.bg-danger Attention


            // QUICK ACTIONS
            .col-md-4.mb-4

              .card

                .card-header.bg-dark.text-white
                  h5.mb-0 Quick Actions

                .card-body

                  a.btn.btn-primary.quick-btn.w-100.mb-3.py-2(href='/sales')
                    i.bi.bi-plus-circle.me-2
                    | New Sale

                  a.btn.btn-success.quick-btn.w-100.mb-3.py-2(href='/stock')
                    i.bi.bi-box-arrow-in-down.me-2
                    | Receive Stock

                  a.btn.btn-warning.quick-btn.w-100.mb-3.py-2(href='/credit')
                    i.bi.bi-credit-card.me-2
                    | Manage Credit

                  a.btn.btn-danger.quick-btn.w-100.py-2(href='/stock')
                    i.bi.bi-exclamation-triangle.me-2
                    | Low Stock Alert


          // RECENT SALES
          .row

            .col-12

              .card

                .card-header.bg-dark.text-white
                  h5.mb-0 Recent Transactions

                .card-body

                  .table-responsive

                    table.table.table-hover

                      thead
                        tr
                          th Product
                          th Customer
                          th Amount
                          th Payment
                          th Date

                      tbody

                        if recentSales && recentSales.length > 0

                          each sale in recentSales

                            tr
                              td= sale.product
                              td= sale.customerName
                              td UGX #{sale.total.toLocaleString()}
                              td= sale.paymentMethod
                              td= new Date(sale.createdAt).toLocaleDateString()

                        else

                          tr
                            td.text-center(colspan='5')
                              | No recent transactions found.


    script.
      const now = new Date();

      const options = {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric'
      };

      document.getElementById('current-date').textContent =
        now.toLocaleDateString('en-US', options);

    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )