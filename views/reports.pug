doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Reports Dashboard - NYONDO HARDWARE

    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')

    style.
      :root {
        --color-charcoal: #212529;    /* Deep Charcoal Base */
        --color-teal: #0d9488;        /* Vibrant Teal Accent */
        --color-silver: #f1f3f5;      /* Polished Silver Background */
      }

      body {
        background: var(--color-silver);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--color-charcoal);
        margin: 0;
      }

      /* Unified Sidebar Component */
      .nyondo-sidebar {
        background-color: var(--color-charcoal);
        width: 260px;
        min-height: 100vh;
        border-right: 3px solid var(--color-teal);
        position: sticky;
        top: 0;
      }

      .nyondo-sidebar .nav-link {
        color: #caecf5;
        opacity: 0.85;
        font-weight: 500;
        padding: 12px 20px;
        border-radius: 8px;
        transition: all 0.2s ease;
      }

      .nyondo-sidebar .nav-link:hover {
        color: #ffffff;
        opacity: 1;
        background-color: rgba(13, 148, 136, 0.15);
      }

      .nyondo-sidebar .nav-link.active {
        color: #ffffff;
        opacity: 1;
        background-color: rgba(13, 148, 136, 0.2);
        border-left: 4px solid var(--color-teal);
        border-radius: 0 8px 8px 0;
      }

      /* Dark Financial Cards */
      .card-dark {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        background: var(--color-charcoal) !important;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
      }

      /* White System/Data Cards */
      .card-white {
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #ffffff !important;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
      }

      /* Premium Accented Report Modules */
      .card-accented {
        border-bottom: 4px solid var(--color-teal);
      }

      .big {
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -0.5px;
      }

      /* Forces all value figures inside dark cards to be completely white */
      .card-dark .big {
        color: #ffffff !important;
      }

      .title {
        font-weight: 800;
        color: var(--color-charcoal);
      }

      .card-white .title {
        color: var(--color-charcoal) !important;
      }

      .metric-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        color: #ffffff !important; /* Forces labels to white */
        opacity: 0.8;
      }

      .text-loss-dark {
        color: #dc2626; /* Dark premium red variant for white context blocks */
      }

      .table-header-custom {
        background-color: var(--color-charcoal);
        color: white;
      }

  body
    .d-flex

      // =========================
      // UNIFIED SYSTEM SIDEBAR
      // =========================
      .nyondo-sidebar.p-4.d-none.d-md-block
        .brand-wrapper.mb-4.pb-3.border-bottom(style="border-color: rgba(255,255,255,0.1) !important;")
          h4.fw-bold.text-white.mb-0 NYONDO #[span(style="color: var(--color-teal);") STOCK]
        
        ul.nav.nav-pills.flex-column.gap-1
          li.nav-item
            a.nav-link(href='/dashboard')
              i.bi.bi-speedometer2.me-2
              | Dashboard
          li.nav-item
            a.nav-link.active(href='/reports')
              i.bi.bi-graph-up-arrow.me-2
              | Business Reports
          li.nav-item
            a.nav-link(href='/sales')
              i.bi.bi-cart-check.me-2
              | Sales Panel
          li.nav-item
            a.nav-link(href='/suppliers')
              i.bi.bi-truck.me-2
              | Suppliers Log
          li.nav-item
            a.nav-link(href='/logout')
              i.bi.bi-box-arrow-left.me-2
              | Sign Out

      // =========================
      // MAIN CONTENT WRAPPER
      // =========================
      .flex-grow-1.p-4.p-md-5

        // =========================
        // HEADER
        // =========================
        .d-flex.align-items-center.mb-5.pb-3.border-bottom(style='border-color: #dee2e6 !important;')
          h2.title.mb-0 
            i.bi.bi-graph-up-arrow.me-3(style='color: var(--color-teal);')
            | Business Reports Dashboard

        // =========================
        // TOP KPI CARDS (Dark Theme)
        // =========================
        .row.g-3

          .col-md-3
            .card-dark.card-accented.p-3
              span.metric-label Today Sales
              p.big.mt-2 UGX #{todayTotal.toLocaleString()}

          .col-md-3
            .card-dark.p-3
              span.metric-label Total Sales
              p.big.mt-2 UGX #{totalSales.toLocaleString()}

          .col-md-3
            .card-dark.p-3
              span.metric-label Net Profit
              p.big.mt-2 UGX #{profit.toLocaleString()}

          .col-md-3
            .card-dark.p-3
              span.metric-label Expected Profit
              p.big.mt-2 UGX #{expectedProfit.toLocaleString()}

        .row.g-3.mt-2

          .col-md-4
            .card-dark.p-3
              span.metric-label Customer Debt Liabilities
              p.big.mt-2 UGX #{totalCustomerDebt.toLocaleString()}

          .col-md-4
            .card-dark.p-3
              span.metric-label Supplier Debt Balances
              p.big.mt-2 UGX #{totalSupplierDebt.toLocaleString()}

          .col-md-4
            .card-dark.card-accented.p-3
              span.metric-label Net Stock Value
              p.big.mt-2 UGX #{stockValue.toLocaleString()}

        // =========================
        // STOCK INSIGHTS (White Theme)
        // =========================
        .card-white.p-4.mt-4(style='border-left: 4px solid var(--color-teal);')
          h5.title.mb-3 
            i.bi.bi-box-seam.me-2(style='color: var(--color-teal);')
            | Stock Insights

          p.mb-0.fs-5
            strong.text-muted Potential Revenue:
            span.fw-bold.ms-2(style='color: var(--color-charcoal);') UGX #{potentialRevenue.toLocaleString()}

        // =========================
        // TOP DEBTORS (White Theme)
        // =========================
        .card-white.p-4.mt-4
          h5.title.mb-3 
            i.bi.bi-bank.me-2(style='color: var(--color-teal);')
            | Top Debtors Accounts

          if topDebtors.length === 0
            p.text-muted.mb-0.py-2 No customers owing money.

          else
            .table-responsive
              table.table.table-hover.align-middle.mt-2.mb-0
                thead.table-header-custom
                  tr
                    th.px-3.py-2 Name
                    th.py-2 Phone Number
                    th.text-end.px-3.py-2 Balance Owed

                tbody
                  each c in topDebtors
                    tr
                      td.px-3.fw-semibold(style='color: var(--color-charcoal);')= c.fullName
                      td(style='color: var(--color-charcoal);')= c.phone
                      td.text-end.px-3.fw-bold.text-loss-dark UGX #{c.balance.toLocaleString()}

        // =========================
        // LOW STOCK ALERT (White Theme)
        // =========================
        .card-white.p-4.mt-4(style='border-bottom: 4px solid #dc2626;')
          h5.title.text-loss-dark.mb-3 
            i.bi.bi-exclamation-octagon-fill.text-danger.me-2
            | Low Stock System Alerts

          if lowStock.length === 0
            p.text-muted.mb-0.py-2 No low stock inventory items identified.

          else
            .table-responsive
              table.table.table-hover.align-middle.mt-2.mb-0
                thead.table-light
                  tr
                    th.px-3 Product Name
                    th.text-end.px-3 Current Stock Unit Quantity

                tbody
                  each item in lowStock
                    tr
                      td.px-3.fw-semibold(style='color: var(--color-charcoal);')= item.productname
                      td.text-end.px-3.fw-bold.text-danger
                        span= item.quantity

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')