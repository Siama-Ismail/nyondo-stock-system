doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Reports Dashboard - NYONDO HARDWARE

    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')

    style.
      :root {
        --primary: #111827;
        --accent: #FD7E14;
        --bg: #f3f4f6;
      }

      body {
        background: var(--bg);
        font-family: sans-serif;
        color: var(--primary);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      }

      .big {
        font-size: 22px;
        font-weight: 800;
      }

      .title {
        font-weight: 800;
      }

  body
    .container.py-5

      // =========================
      // HEADER
      // =========================
      h2.title.mb-4 📊 Business Reports Dashboard

      // =========================
      // TOP KPI CARDS
      // =========================
      .row.g-3

        .col-md-3
          .card.p-3
            h6 Today Sales
            p.big.text-success UGX #{todayTotal.toLocaleString()}

        .col-md-3
          .card.p-3
            h6 Total Sales
            p.big UGX #{totalSales.toLocaleString()}

        .col-md-3
          .card.p-3
            h6 Profit
            p.big.text-primary UGX #{profit.toLocaleString()}

        .col-md-3
          .card.p-3
            h6 Expected Profit
            p.big.text-info UGX #{expectedProfit.toLocaleString()}

      .row.g-3.mt-2

        .col-md-4
          .card.p-3
            h6 Customer Debt
            p.big.text-danger UGX #{totalCustomerDebt.toLocaleString()}

        .col-md-4
          .card.p-3
            h6 Supplier Debt
            p.big.text-warning UGX #{totalSupplierDebt.toLocaleString()}

        .col-md-4
          .card.p-3
            h6 Stock Value
            p.big UGX #{stockValue.toLocaleString()}

      // =========================
      // STOCK INSIGHTS
      // =========================
      .card.p-3.mt-4
        h5.title 📦 Stock Insights

        p
          strong Potential Revenue:
          |  UGX #{potentialRevenue.toLocaleString()}

      // =========================
      // TOP DEBTORS
      // =========================
      .card.p-3.mt-4
        h5.title 🏦 Top Debtors

        if topDebtors.length === 0
          p.text-muted No customers owing money

        else
          table.table.table-sm.mt-2
            thead
              tr
                th Name
                th Phone
                th Balance

            tbody
              each c in topDebtors
                tr
                  td= c.fullName
                  td= c.phone
                  td.text-danger UGX #{c.balance.toLocaleString()}

      // =========================
      // LOW STOCK ALERT
      // =========================
      .card.p-3.mt-4
        h5.title ⚠️ Low Stock Alert

        if lowStock.length === 0
          p.text-muted No low stock items

        else
          table.table.table-sm.mt-2
            thead
              tr
                th Product
                th Quantity

            tbody
              each item in lowStock
                tr
                  td= item.productname
                  td.text-danger= item.quantity