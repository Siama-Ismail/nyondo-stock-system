doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Reports Dashboard - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      body {
        background: #E5E7EB;
        font-family: 'Segoe UI', sans-serif;
      }

      .sidebar {
        background: #111827;
        min-height: 100vh;
        position: fixed;
        width: 250px;
        color: white;
      }

      .sidebar a {
        display: block;
        padding: 12px 20px;
        color: #9ca3af;
        text-decoration: none;
      }

      .sidebar a:hover {
        background: #1f2937;
        color: #10B981;
      }

      .main {
        margin-left: 250px;
        padding: 30px;
      }

      .card-box {
        border-radius: 12px;
        padding: 20px;
        color: white;
        font-weight: bold;
      }

      .bg1 { background: #10B981; }
      .bg2 { background: #111827; }
      .bg3 { background: #F59E0B; }
      .bg4 { background: #EF4444; }

      .section {
        background: white;
        border-radius: 12px;
        padding: 20px;
        margin-top: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
      }

  body

    // SIDEBAR
    .sidebar
      h4.p-3 NYONDO REPORTS

      a(href='/dashboard') Dashboard
      a(href='/sales') Sales
      a(href='/stock') Stock
      a(href='/credit') Credits
      a(href='/reports') Reports

    // MAIN
    .main

      h2.mb-4 Reports Dashboard

      // ================= KPI CARDS =================
      .row.g-3

        .col-md-3
          .card-box.bg1
            h6 Total Sales
            h3 UGX #{totalSales.toLocaleString()}

        .col-md-3
          .card-box.bg2
            h6 Inventory Value
            h3 UGX #{inventoryValue.toLocaleString()}

        .col-md-3
          .card-box.bg3
            h6 Expected Profit
            h3 UGX #{expectedProfit.toLocaleString()}

        .col-md-3
          .card-box.bg4
            h6 Total Credit Debt
            h3 UGX #{totalDebt.toLocaleString()}

      // ================= SALES TABLE =================
      .section
        h5.mb-3 Recent Sales

        table.table.table-striped
          thead
            tr
              th Customer
              th Items
              th Total
              th Date

          tbody
            each s in sales
              tr
                td= s.customerName
                td= s.items.length
                td UGX #{s.total.toLocaleString()}
                td= new Date(s.createdAt).toLocaleDateString()

      // ================= STOCK TABLE =================
      .section
        h5.mb-3 Low Stock Items

        table.table.table-hover
          thead
            tr
              th Product
              th Qty
              th Status

          tbody
            each st in lowStock
              tr
                td= st.productname
                td= st.quantity
                td.text-danger Low Stock

      // ================= CREDIT SUMMARY =================
      .section
        h5.mb-3 Supplier Credit Overview

        table.table.table-bordered
          thead
            tr
              th Supplier
              th Amount
              th Paid
              th Balance
              th Status

          tbody
            each c in credits
              tr
                td= c.supplierName
                td UGX #{c.amount.toLocaleString()}
                td UGX #{c.paid.toLocaleString()}
                td.text-danger UGX #{c.balance.toLocaleString()}
                td
                  if c.status == 'PAID'
                    span.badge.bg-success PAID
                  else
                    span.badge.bg-warning.text-dark UNPAID