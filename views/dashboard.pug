doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title NYONDO General Hardware LTD - Quality Building Materials
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')
    link(rel='stylesheet' href='/css/responsive.css')
    style.
      :root {
        --charcoal: #212529;      /* Deep Charcoal */
        --teal: #0d9488;          /* Vibrant Teal */
        --silver-bg: #f1f3f5;      /* Polished Silver background canvas */
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--silver-bg);
        color: var(--charcoal);
      }
      .navbar {
        background-color: rgba(33, 37, 41, 0.95) !important; /* Rich charcoal solid header */
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        padding: 0.8rem 0;
      }
      .navbar-brand span { color: var(--teal); }
      
      /* FIXED PATH: Matches your exact filename 'nyodostock.png' inside '/images/' */
      .hero-section {
        background: linear-gradient(rgba(33, 37, 41, 0.7), rgba(33, 37, 41, 0.7)), url('/images/nyodostock.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        color: #ffffff;
        height: 100vh;
        display: flex;
        align-items: center;
        text-align: center;
      }
      
      .text-teal { color: var(--teal) !important; }
      .btn-primary {
        background-color: var(--teal);
        border-color: var(--teal);
        color: #ffffff;
        font-weight: 700;
        padding: 0.8rem 2rem;
        transition: 0.3s ease;
      }
      .btn-primary:hover {
        background-color: #0f766e;
        border-color: #0f766e;
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(13, 148, 136, 0.2);
      }
      footer {
        background-color: var(--charcoal) !important;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }
  body
    // Navbar
    nav.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container
        a.navbar-brand.fw-bold.fs-3(href='#')
          | NYONDO STOCK 
          span GENERAL HARDWARE
        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto.align-items-center
            li.nav-item
              a.btn.btn-primary.px-4.shadow-sm(href='/login') Login

    // Hero Section
    section.hero-section
      .container
        .row.justify-content-center
          .col-lg-9
            h1.display-3.fw-bold.mb-4
              | Quality Building Materials & 
              span.text-teal Hardware
            p.lead.mb-5.opacity-75 Supplying Uganda's construction industry with premium materials since 2005.
            .d-flex.justify-content-center.gap-3
              
    // Footer
    footer.text-white.py-5
      .container.text-center
        h4.fw-bold.mb-3.text-white
          | NYONDO 
          span.text-teal STOCK
        p.opacity-50.small © 2026 NYONDO General Hardware LTD. All rights reserved.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')