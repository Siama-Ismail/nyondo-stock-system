doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Customer Credit History

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background: var(--color-teal);
        color: white;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }

      .btn-nyondo-secondary {
        background: var(--color-charcoal);
        color: white;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo-secondary:hover {
        background: #343a40;
        color: white;
      }
      
      .badge-teal-clear {
        background-color: var(--color-teal) !important;
        color: white !important;
      }
      
      .badge-charcoal-pending {
        background-color: transparent !important;
        color: var(--color-charcoal) !important;
        border: 1px solid var(--color-charcoal);
      }

      .text-teal-gain {
        color: var(--color-teal);
      }

      .st-sidebar {
        width: 260px;
        height: 100vh;
        background-color: #212529;
        border-right: 3px solid #0d9488;
        position: fixed;
        top: 0;
        left: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        z-index: 1000;
      }

      .st-sidebar .navbar-brand {
        font-size: 1.5rem;
        text-decoration: none;
        color: white;
        font-weight: 800;
        margin-bottom: 30px;
      }

      .st-sidebar .navbar-brand span { color: #0d9488; }

      .st-sidebar .nav-link {
        color: #caecf5;
        opacity: 0.85;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: 0.3s;
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .st-sidebar .nav-link:hover,
      .st-sidebar .nav-link.active {
        background-color: rgba(13, 148, 136, 0.15);
        color: #ffffff !important;
        opacity: 1;
      }

      .st-sidebar .nav-link.active {
        border-left: 4px solid #0d9488;
        border-radius: 0 8px 8px 0;
      }

      .main-content {
        margin-left: 260px;
        width: calc(100% - 260px);
        padding: 40px;
      }

  body
    .st-sidebar
      a.navbar-brand(href='/admin')
        | NYONDO
        span STOCK

      nav.nav.flex-column
        a.nav-link(href='/admin')
          i.bi.bi-speedometer2.me-2
          span Dashboard
        a.nav-link.active(href='/credit')
          i.bi.bi-cash-stack.me-2
          span Credit
        a.nav-link(href='/stock')
          i.bi.bi-box-seam.me-2
          span Inventory
        a.nav-link(href='/manage-stock')
          i.bi.bi-journal-text.me-2
          span Ledger
        a.nav-link(href='/logout')
          i.bi.bi-box-arrow-right.me-2.text-danger
          span Logout

    .main-content
      .container.py-5

      .d-flex.justify-content-between.align-items-center.mb-4

        h2.fw-bold CREDIT TRACKING

        a.btn.btn-nyondo-secondary(
          href='/credit'
        ) Back

      .card.p-4.mb-4

        h4.fw-bold= customer.fullName

        p.mb-2
          strong Phone:
          |  #{customer.phone}

        p.mb-0
          strong Total Account Balance:
          span.text-dark.fw-bold
            |  UGX #{customer.balance.toLocaleString()}

      if groupedItems.length === 0

        .alert.alert-secondary
          | No credit records found.

      each item in groupedItems

        .card.p-4.mb-4

          .d-flex.justify-content-between.align-items-center

            h5.fw-bold= item.item

            if item.status === 'CLEAR'
              span.badge.badge-teal-clear CLEAR
            else
              span.badge.badge-charcoal-pending PENDING

          hr

          .row

            .col-md-3.mb-3

              p.mb-1.fw-bold Quantity

              p= item.quantity

            .col-md-3.mb-3

              p.mb-1.fw-bold Total Cost

              p
                | UGX #{item.totalPrice.toLocaleString()}

            .col-md-3.mb-3

              p.mb-1.fw-bold Amount Paid

              p.text-teal-gain.fw-bold
                | UGX #{item.totalPaid.toLocaleString()}

            .col-md-3.mb-3

              p.mb-1.fw-bold Remaining Balance

              p.text-dark.fw-bold
                | UGX #{item.remainingBalance.toLocaleString()}

          hr

          p.mb-1
            strong Date:
            |  #{new Date(item.createdAt).toLocaleDateString()}

          .d-flex.flex-wrap.gap-2.mt-4

            a.btn.btn-nyondo-secondary(
              href='/edit-credit/' + item.id
            ) Edit

            form(
              action='/delete-credit/' + item.id
              method='POST'
              onsubmit="return confirm('Delete this record?')"
            )

              button.btn.btn-nyondo-secondary(
                type='submit'
              ) Delete

            a.btn.btn-nyondo-secondary(
              href='/credit-receipt/' + item.id
            ) Receipt