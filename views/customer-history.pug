doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Customer Credit History

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background: var(--color-teal);
        color: white;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }

      .btn-nyondo-secondary {
        background: var(--color-charcoal);
        color: white;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo-secondary:hover {
        background: #343a40;
        color: white;
      }
      
      .badge-teal-clear {
        background-color: var(--color-teal) !important;
        color: white !important;
      }
      
      .badge-charcoal-pending {
        background-color: transparent !important;
        color: var(--color-charcoal) !important;
        border: 1px solid var(--color-charcoal);
      }

      .text-teal-gain {
        color: var(--color-teal);
      }

  body

    .container.py-5

      .d-flex.justify-content-between.align-items-center.mb-4

        h2.fw-bold CREDIT TRACKING

        a.btn.btn-nyondo-secondary(
          href='/credit'
        ) Back

      .card.p-4.mb-4

        h4.fw-bold= customer.fullName

        p.mb-2
          strong Phone:
          |  #{customer.phone}

        p.mb-0
          strong Total Account Balance:
          span.text-dark.fw-bold
            |  UGX #{customer.balance.toLocaleString()}

      if groupedItems.length === 0

        .alert.alert-secondary
          | No credit records found.

      each item in groupedItems

        .card.p-4.mb-4

          .d-flex.justify-content-between.align-items-center

            h5.fw-bold= item.item

            if item.status === 'CLEAR'
              span.badge.badge-teal-clear CLEAR
            else
              span.badge.badge-charcoal-pending PENDING

          hr

          .row

            .col-md-3.mb-3

              p.mb-1.fw-bold Quantity

              p= item.quantity

            .col-md-3.mb-3

              p.mb-1.fw-bold Total Cost

              p
                | UGX #{item.totalPrice.toLocaleString()}

            .col-md-3.mb-3

              p.mb-1.fw-bold Amount Paid

              p.text-teal-gain.fw-bold
                | UGX #{item.totalPaid.toLocaleString()}

            .col-md-3.mb-3

              p.mb-1.fw-bold Remaining Balance

              p.text-dark.fw-bold
                | UGX #{item.remainingBalance.toLocaleString()}

          hr

          p.mb-1
            strong Date:
            |  #{new Date(item.createdAt).toLocaleDateString()}

          .d-flex.flex-wrap.gap-2.mt-4

            a.btn.btn-nyondo-secondary(
              href='/edit-credit/' + item.id
            ) Edit

            form(
              action='/delete-credit/' + item.id
              method='POST'
              onsubmit="return confirm('Delete this record?')"
            )

              button.btn.btn-nyondo-secondary(
                type='submit'
              ) Delete

            a.btn.btn-nyondo-secondary(
              href='/credit-receipt/' + item.id
            ) Receipt