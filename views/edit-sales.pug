// =========================
// views/edit-sales.pug
// =========================

doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Edit Sale - NYONDO Stock

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: 'Segoe UI', sans-serif;
        color: var(--color-charcoal);
      }

      .card-box {
        background: #fff;
        border-radius: 14px;
        padding: 25px;
        max-width: 900px;
        margin: 40px auto;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
        border: none;
      }

      .title {
        font-weight: 800;
        font-size: 24px;
        border-bottom: 3px solid var(--color-teal);
        display: inline-block;
        padding-bottom: 6px;
        margin-bottom: 25px;
        color: var(--color-charcoal);
      }

      .form-label {
        font-weight: 600;
        color: var(--color-charcoal);
        font-size: 14px;
      }

      .form-control,
      .form-select {
        border-radius: 8px;
        padding: 10px;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--color-teal);
        box-shadow: none;
      }

      .summary-box {
        background: transparent;
        border-radius: 10px;
        padding: 15px;
        border: 1px solid var(--color-charcoal);
      }

      .summary-title {
        font-size: 13px;
        color: var(--color-charcoal);
        opacity: 0.8;
      }

      .summary-value {
        font-size: 20px;
        font-weight: 800;
        color: var(--color-charcoal);
      }

      /* Unified Action Components */
      .btn-nyondo {
        background: var(--color-teal);
        border: none;
        color: white;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        width: 100%;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e;
        color: white;
      }

      .btn-nyondo-secondary {
        background: var(--color-charcoal);
        border: none;
        color: white;
        font-weight: 700;
        padding: 12px;
        border-radius: 8px;
        width: 100%;
        text-decoration: none;
        display: inline-block;
        text-align: center;
        transition: background 0.2s ease;
      }

      .btn-nyondo-secondary:hover {
        background: #343a40;
        color: white;
      }

  body

    .card-box

      h2.title
        i.bi.bi-pencil-square.me-2
        | Edit Sale

      form(action='/update-sales/' + sale._id method='POST')

        .row.g-3

          .col-md-6
            label.form-label Product

            select.form-select(
              name='product'
              id='productSelect'
              required
            )

              each stock in stocks
                option(
                  value=stock.productname
                  data-price=stock.sellingPrice
                  selected=sale.items[0].product == stock.productname
                )
                  | #{stock.productname} - UGX #{stock.sellingPrice.toLocaleString()}

          .col-md-6
            label.form-label Quantity

            input.form-control(
              type='number'
              name='quantity'
              id='quantity'
              value=sale.items[0].quantity
              min='1'
              required
            )

          .col-md-6
            label.form-label Unit Price

            input.form-control(
              type='number'
              name='unitPrice'
              id='unitPrice'
              value=sale.items[0].sellingPrice
              readonly
            )

          .col-md-6
            label.form-label Customer Name

            input.form-control(
              type='text'
              name='customerName'
              value=sale.customerName
              required
            )

          .col-md-6
            label.form-label Customer Contact
            input.form-control(
              type="tel" 
              name="customerContact" 
              id="customerPhoneInput" 
              value=(oldData && oldData.customerContact ? oldData.customerContact : "+256") 
              maxlength="13" 
              pattern="^\\+256[0-9]{9}$" 
              title="Phone number must start with +256 followed by exactly 9 digits"
              class=(errors && errors.customerContact? 'is-invalid' : '')
              required
              )

          .col-md-6
            label.form-label Payment Method

            select.form-select(
              name='paymentMethod'
              required
            )

              option(
                value='Cash'
                selected=sale.paymentMethod == 'Cash'
              ) Cash

              option(
                value='Mobile Money'
                selected=sale.paymentMethod == 'Mobile Money'
              ) Mobile Money

              option(
                value='Credit'
                selected=sale.paymentMethod == 'Credit'
              ) Credit

          .col-md-6
            label.form-label Delivery Distance (KM)

            input.form-control(
              type='number'
              name='deliveryDistance'
              id='distance'
              value=sale.deliveryDistance
              required
            )

        .row.mt-4.g-3

          .col-md-4
            .summary-box
              .summary-title Transport Fee
              .summary-value#transportFee UGX 0

          .col-md-4
            .summary-box
              .summary-title Item Total
              .summary-value#totalAmount UGX 0

          .col-md-4
            .summary-box
              .summary-title Grand Total
              .summary-value#grandTotal UGX 0

        .row.mt-4.g-2

          .col-md-6
            button.btn-nyondo(type='submit')
              i.bi.bi-check-circle.me-2
              | Save Changes

          .col-md-6
            a.btn-nyondo-secondary(href='/sales')
              i.bi.bi-x-circle.me-2
              | Cancel

    script.

      const productSelect =
        document.getElementById('productSelect');

      const quantityInput =
        document.getElementById('quantity');

      const unitPriceInput =
        document.getElementById('unitPrice');

      const distanceInput =
        document.getElementById('distance');

      const transportFeeText =
        document.getElementById('transportFee');

      const totalAmountText =
        document.getElementById('totalAmount');

      const grandTotalText =
        document.getElementById('grandTotal');

      function calculateTotals() {

        const selectedOption =
          productSelect.options[productSelect.selectedIndex];

        const unitPrice =
          Number(selectedOption.getAttribute('data-price')) || 0;

        const quantity =
          Number(quantityInput.value) || 0;

        const distance =
          Number(distanceInput.value) || 0;

        unitPriceInput.value = unitPrice;

        const totalAmount =
          unitPrice * quantity;

        let transportFee = 30000;

        if (distance <= 10 && totalAmount >= 500000) {
          transportFee = 0;
        }

        const grandTotal =
          totalAmount + transportFee;

        transportFeeText.innerText =
          'UGX ' + transportFee.toLocaleString();

        totalAmountText.innerText =
          'UGX ' + totalAmount.toLocaleString();

        grandTotalText.innerText =
          'UGX ' + grandTotal.toLocaleString();
      }

      calculateTotals();

      productSelect.addEventListener(
        'change',
        calculateTotals
      );

      quantityInput.addEventListener(
        'input',
        calculateTotals
      );

      distanceInput.addEventListener(
        'input',
        calculateTotals
      );