doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Logged Out - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;    /* Deep Charcoal Base */
        --color-teal: #0d9488;        /* Vibrant Teal Accent */
        --color-silver: #f1f3f5;      /* Polished Silver Background */
      }

      body {
        background-color: var(--color-silver);
        color: var(--color-charcoal);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: var(--color-charcoal);
        border-bottom: 3px solid var(--color-teal);
      }

      .main-content {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .logout-card {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 20px;
        padding: 50px;
        width: 100%;
        max-width: 450px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      }

      .nyondo-text {
        font-weight: 800;
        color: var(--color-silver);
      }

      .stock-text {
        color: var(--color-teal);
        font-weight: 800;
      }

      .logout-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: rgba(13, 148, 136, 0.1);
        border: 2px solid var(--color-teal);
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        margin-bottom: 25px;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background-color: var(--color-teal);
        border: none;
        color: white;
        padding: 14px 30px;
        font-weight: 700;
        border-radius: 10px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s ease-in-out;
      }

      .btn-nyondo:hover {
        background-color: #0f766e;
        color: white;
        transform: translateY(-2px);
      }

      footer {
        text-align: center;
        padding: 20px;
        opacity: 0.7;
      }

  body

    // NAVBAR
    nav.navbar.navbar-dark
      .container.justify-content-center
        a.navbar-brand(href='/dashboard')
          span.nyondo-text NYONDO 
          span.stock-text STOCK

    // MAIN CONTENT
    .main-content
      .logout-card
        .logout-icon
          i.bi.bi-box-arrow-right.fs-1(style='color: var(--color-teal)')

        h2.fw-bold.mb-3 Logged Out Successfully

        p.text-muted.mb-4
          | Your session has been closed securely.
          br
          | Thank you for using NYONDO STOCK Management System.

        a.btn-nyondo(href='/login')
          i.bi.bi-lock-fill.me-2
          | LOGIN AGAIN

    footer
      p.small.mb-0
        | © 2026 NYONDO General Hardware LTD

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')