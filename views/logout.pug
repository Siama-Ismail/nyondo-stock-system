doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Logged Out - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      body {
        background-color: #0f172a;
        color: #ffffff;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: rgba(255,255,255,0.03);
        border-bottom: 1px solid rgba(255,255,255,0.08);
      }

      .main-content {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .logout-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        padding: 50px;
        width: 100%;
        max-width: 450px;
        text-align: center;
      }

      .nyondo-text {
        font-weight: 800;
        color: #ffffff;
      }

      .stock-text {
        color: #f97316;
        font-weight: 800;
      }

      .logout-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: rgba(249,115,22,0.1);
        border: 2px solid #f97316;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        margin-bottom: 25px;
      }

      .btn-orange {
        background-color: #f97316;
        border: none;
        color: white;
        padding: 14px 30px;
        font-weight: 700;
        border-radius: 10px;
        transition: 0.3s;
      }

      .btn-orange:hover {
        background-color: #ea580c;
        transform: translateY(-2px);
      }

      footer {
        text-align: center;
        padding: 20px;
        opacity: 0.6;
      }

  body

    // NAVBAR
    nav.navbar.navbar-dark
      .container.justify-content-center
        a.navbar-brand(href='/dashboard')
          span.nyondo-text NYONDO
          span.stock-text  STOCK

    // MAIN CONTENT
    .main-content

      .logout-card

        .logout-icon
          i.bi.bi-box-arrow-right.fs-1(style='color:#f97316')

        h2.fw-bold.mb-3 Logged Out Successfully

        p.opacity-75.mb-4
          | Your session has been closed securely.
          br
          | Thank you for using NYONDO STOCK Management System.

        a.btn.btn-orange(href='/login')
          i.bi.bi-lock-fill.me-2
          | LOGIN AGAIN

    footer
      p.small.mb-0
        | © 2026 NYONDO General Hardware LTD

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')