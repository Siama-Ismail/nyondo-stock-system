doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Logged Out - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      body {
        background-color: #E5E7EB; /* Changed to Silver Gray */
        color: #111827; /* Changed to Matte Black text */
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
      }

      .navbar {
        background-color: #111827; /* Matte Black header band */
        border-bottom: 3px solid #10B981; /* Premium Emerald Accent border */
      }

      .main-content {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .logout-card {
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 20px;
        padding: 50px;
        width: 100%;
        max-width: 450px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.05);
      }

      .nyondo-text {
        font-weight: 800;
        color: #ffffff;
      }

      .stock-text {
        color: #10B981; /* Changed to Emerald Green */
        font-weight: 800;
      }

      .logout-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: rgba(16, 185, 129, 0.1);
        border: 2px solid #10B981; /* Changed to Emerald Green */
        display: flex;
        justify-content: center;
        align-items: center;
        margin: auto;
        margin-bottom: 25px;
      }

      .btn-orange {
        background-color: #10B981; /* Changed to Emerald Green */
        border: none;
        color: #111827; /* Dark high-contrast label */
        padding: 14px 30px;
        font-weight: 700;
        border-radius: 10px;
        transition: 0.3s;
      }

      .btn-orange:hover {
        background-color: #059669; /* Richer hover state green */
        color: white;
        transform: translateY(-2px);
      }

      footer {
        text-align: center;
        padding: 20px;
        opacity: 0.7;
      }

  body

    // NAVBAR
    nav.navbar.navbar-dark
      .container.justify-content-center
        a.navbar-brand(href='/dashboard')
          span.nyondo-text NYONDO
          span.stock-text  STOCK

    // MAIN CONTENT
    .main-content

      .logout-card

        .logout-icon
          i.bi.bi-box-arrow-right.fs-1(style='color:#10B981')

        h2.fw-bold.mb-3 Logged Out Successfully

        p.text-muted.mb-4
          | Your session has been closed securely.
          br
          | Thank you for using NYONDO STOCK Management System.

        a.btn.btn-orange(href='/login')
          i.bi.bi-lock-fill.me-2
          | LOGIN AGAIN

    footer
      p.small.mb-0
        | © 2026 NYONDO General Hardware LTD

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')