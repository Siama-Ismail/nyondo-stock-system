doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Staff Registration - NYONDO STOCK

    // Bootstrap
    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    // Bootstrap Icons
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --primary-navy: #212529;      /* Deep Charcoal Base */
        --charcoal: #343a40;          /* Subdued Neutral Body Text */
        --accent-orange: #0d9488;     /* Vibrant Teal Accent */
        --light-bg: #f1f3f5;          /* Polished Silver Background */
      }

      body {
        background-color: var(--light-bg);
        color: var(--charcoal);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .registration-card {
        max-width: 550px;
        margin: 4rem auto;
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(33, 37, 41, 0.08);
        border: 1px solid #dee2e6;
        overflow: hidden;
      }

      .card-header {
        background: var(--primary-navy) !important;
        border-bottom: 4px solid var(--accent-orange) !important;
        color: white;
        padding: 1.5rem;
      }

      .form-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--primary-navy);
        text-transform: uppercase;
        margin-bottom: 6px;
      }

      .btn-nyondo {
        background: var(--accent-orange) !important;
        color: #ffffff !important;
        font-weight: 700;
        border: none;
        padding: 0.9rem;
        letter-spacing: 1px;
        transition: 0.3s;
      }

      .btn-nyondo:hover {
        background: #0b7a70 !important;
        color: white !important;
      }

      .form-control:focus,
      .form-select:focus {
        border-color: var(--accent-orange);
        box-shadow: 0 0 0 0.15rem rgba(13,148,136,0.15);
      }

      .staff-icon {
        font-size: 3rem;
        color: var(--accent-orange);
        margin-bottom: 1rem;
      }

  body

    .container

      .card.registration-card

        .card-header.text-center
          h4.mb-0.fw-bold STAFF ONBOARDING

        .card-body.p-4.p-md-5

          .text-center.mb-4
            i.bi.bi-person-badge.staff-icon

            p.text-muted.small.mb-0
              | Register a new employee account for the hardware management system.

          // FORM
          form(action='/signup' method='POST' novalidate)

            .row.g-3

              // FULL NAME
              .col-12
                label.form-label Full Name

                input.form-control(
                  type='text'
                  name='fullname'
                  placeholder='Employee Name'
                  value=(typeof fullname !== 'undefined' ? fullname : '')
                  class=(fieldErrors && fieldErrors.fullname ? 'is-invalid' : '')
                  required
                )
                if fieldErrors && fieldErrors.fullname
                  .invalid-feedback.d-block= fieldErrors.fullname

              // EMAIL
              .col-12
                label.form-label Staff Email

                input.form-control(
                  type='email'
                  name='email'
                  placeholder='name@nyondo.com'
                  value=(typeof email !== 'undefined' ? email : '')
                  class=(fieldErrors && fieldErrors.email ? 'is-invalid' : '')
                  required
                )
                if fieldErrors && fieldErrors.email
                  .invalid-feedback.d-block= fieldErrors.email

              // PHONE
              .col-md-6
                label.form-label Phone Number
                input.form-control(
                  type='tel'
                  name='phonenumber'
                  id='customerPhoneInput'
                  value=(typeof phonenumber !== 'undefined' ? phonenumber : '')
                  maxlength='13'
                  pattern='^(?:\+2567|07)\d{8}$'
                  title='Enter +2567XXXXXXXX or 07XXXXXXXX'
                  class=(fieldErrors && fieldErrors.phonenumber ? 'is-invalid' : '')
                  required
                )
                if fieldErrors && fieldErrors.phonenumber
                  .invalid-feedback.d-block= fieldErrors.phonenumber

              .col-md-6
                label.form-label NIN
                input.form-control(
                  type='text'
                  name='nin'
                  id='customerNINInput'
                  placeholder='e.g., CM92012345XYZW'
                  value=(typeof nin !== 'undefined' ? nin : '')
                  minlength='14'
                  maxlength='14'
                  pattern='^[A-Za-z0-9]{14}$'
                  title='NIN must be exactly 14 letters or digits'
                  style='text-transform: uppercase;'
                  class=(fieldErrors && fieldErrors.nin ? 'is-invalid' : '')
                  required
                )
                if fieldErrors && fieldErrors.nin
                  .invalid-feedback.d-block= fieldErrors.nin

              // ROLE
              .col-md-6
                label.form-label Role

                select.form-select(name='role' required class=(fieldErrors && fieldErrors.role ? 'is-invalid' : ''))

                  option(value='' disabled selected)
                    | Select user role

                  option(value='admin' selected=(typeof role !== 'undefined' && role === 'admin'))
                    | Admin

                  option(value='store_manager' selected=(typeof role !== 'undefined' && role === 'store_manager'))
                    | Store Manager

                  option(value='sales_attendant' selected=(typeof role !== 'undefined' && role === 'sales_attendant'))
                    | Sales Attendant
                if fieldErrors && fieldErrors.role
                  .invalid-feedback.d-block= fieldErrors.role

              // PASSWORD
              .col-md-6
                label.form-label Password

                input.form-control(
                  type='password'
                  name='password'
                  minlength='8'
                  placeholder='Minimum 8 characters'
                  class=(fieldErrors && fieldErrors.password ? 'is-invalid' : '')
                  required
                )
                if fieldErrors && fieldErrors.password
                  .invalid-feedback.d-block= fieldErrors.password

              // SUBMIT BUTTON
              .col-12.mt-3

                button.btn.btn-nyondo.w-100(type='submit')
                  i.bi.bi-person-plus.me-2
                  | REGISTER STAFF

              // BACK BUTTON
              .col-12.text-center.mt-2

                a.text-decoration-none.small(
                  href='/admin'
                  style='color: var(--primary-navy)'
                )

                  i.bi.bi-arrow-left.me-1

                  | Back to Dashboard


          script.
            (function(){
              var firstInvalid = document.querySelector('.is-invalid');
              if(firstInvalid) firstInvalid.focus();
            })();

    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )