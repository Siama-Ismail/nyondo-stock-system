doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Stock - NYONDO STOCK General Hardware

    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')

    style.
      :root {
        --brand-navy: #212529;       /* Deep Charcoal Base */
        --brand-orange: #0d9488;     /* Vibrant Teal Accent */
        --sidebar-hover: rgba(13, 148, 136, 0.15); /* Clean Translucent Teal Hover */
        --light-bg: #f1f3f5;         /* Polished Silver Background */
        --charcoal: #343a40;          /* Subdued Body Text */
      }

      body { 
        background-color: var(--light-bg); 
        color: var(--charcoal); 
        min-height: 100vh; 
        margin: 0; 
        font-family: 'Inter', system-ui, -apple-system, sans-serif; 
        overflow-x: hidden; 
      }

      .st-sidebar { 
        width: 260px; 
        height: 100vh; 
        background-color: var(--brand-navy); 
        border-right: 3px solid var(--brand-orange); 
        position: fixed; 
        top: 0; 
        left: 0; 
        padding: 20px; 
        display: flex; 
        flex-direction: column; 
        z-index: 1000; 
      }

      .st-sidebar .navbar-brand { 
        font-size: 1.5rem; 
        text-decoration: none; 
        color: white; 
        font-weight: 800; 
        margin-bottom: 30px; 
      }

      .st-sidebar .navbar-brand span { 
        color: var(--brand-orange); 
      }

      .st-sidebar .nav-link { 
        color: #caecf5; 
        opacity: 0.85;
        padding: 12px 15px; 
        border-radius: 8px; 
        margin-bottom: 8px; 
        transition: 0.3s; 
        display: flex; 
        align-items: center; 
        text-decoration: none; 
      }

      .st-sidebar .nav-link:hover, .st-sidebar .nav-link.active { 
        background-color: var(--sidebar-hover); 
        color: #ffffff !important; 
        opacity: 1;
      }

      .st-sidebar .nav-link.active {
        border-left: 4px solid var(--brand-orange);
        border-radius: 0 8px 8px 0;
      }

      .main-content { 
        margin-left: 260px; 
        width: calc(100% - 260px); 
        padding: 40px; 
      }

      .st-main-h { 
        font-weight: 800; 
        margin-bottom: 30px; 
        color: var(--brand-navy); 
      }

      .st-card-style { 
        background: #ffffff; 
        color: var(--brand-navy); 
        border-radius: 12px; 
        border: none; 
        box-shadow: 0 10px 25px rgba(0,0,0,0.03); 
        overflow: hidden; 
        border: 1px solid #dee2e6; 
      }

      .st-accent-text { 
        color: var(--brand-navy); 
        font-weight: 700; 
        border-bottom: 3px solid var(--brand-orange); 
        padding-bottom: 10px; 
        margin-bottom: 20px; 
        display: inline-block; 
      }

      .st-btn-dark { 
        background-color: var(--brand-orange); 
        color: #ffffff; 
        border: none; 
        font-weight: 700; 
        transition: 0.3s; 
        padding: 12px; 
        border-radius: 8px; 
      }

      .st-btn-dark:hover { 
        background-color: #0b7a70; 
        color: #ffffff; 
      }

      .stat-card-dark { 
        background-color: var(--brand-navy); 
        border: 1px solid rgba(255,255,255,0.1); 
        color: white; 
        border-radius: 12px; 
      }

      .st-low-alert { 
        color: #dc2626; 
        background-color: #fee2e2; 
        padding: 4px 10px; 
        border-radius: 6px; 
        font-weight: 700; 
        font-size: 0.75rem;
        display: inline-block;
      }

      .table-responsive { 
        width: 100%; 
        overflow-x: auto; 
      }

      .table { 
        width: 100%; 
        min-width: 1100px; 
        font-size: 0.85rem; 
        vertical-align: middle; 
      }

      .form-label { 
        font-size: 0.85rem; 
        font-weight: 600; 
        color: #64748b; 
      }

      /* Unified Inline Edit Button Override */
      .btn-outline-dark {
        color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        background: transparent !important;
        font-weight: 600;
      }

      .btn-outline-dark:hover {
        background-color: var(--brand-orange) !important;
        color: #ffffff !important;
      }

      /* Safe Premium Red Exception styling for Delete Actions */
      .btn-danger {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
        font-weight: 600;
        border: none;
      }

      .btn-danger:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
      }

  body
    // SIDEBAR
    .st-sidebar
      a.navbar-brand(href='/dashboard')
        span NYONDO 
        span STOCK

      nav.nav.flex-column
        a.nav-link(href='/dashboard')
          i.bi.bi-speedometer2.me-2
          span Home 

        a.nav-link.active(href='/stock')
          i.bi.bi-box-seam.me-2
          span Inventory

        a.nav-link.active(href='/manage-stock')
          i.bi.bi-box-seam.me-2
          span Lifetime Stock Ledger

        a.nav-link(href='/logout')
          i.bi.bi-box-arrow-right.me-2.text-danger
          span Logout

    // MAIN CONTENT
    .main-content
      h2.st-main-h Inventory Control

      if error
        .alert.alert-danger= error

      // STATS (Borders removed from the second and third cards)
      .row.mb-4
        .col-md-4.mb-3
          .card.stat-card-dark.p-3
            h6.text-white-50.small.text-uppercase Total Products
            h4.fw-bold.mb-0 #{totalItems || 0}

        .col-md-4.mb-3
          .card.stat-card-dark.p-3
            h6.text-success.small.text-uppercase Inventory Value
            h4.fw-bold.mb-0 UGX #{(inventoryValue || 0).toLocaleString()}

        .col-md-4.mb-3
          .card.stat-card-dark.p-3
            h6.text-danger.small.text-uppercase Low Stock Alerts
            h4.fw-bold.mb-0 #{(lowStock || []).length} Items

      // FORM
      .row.mb-4
        .col-12
          .card.st-card-style.p-4
            h5.st-accent-text Record New Stock

            if success
              - const successMessage = Array.isArray(success) ? success[0] : success
              .alert.alert-success.alert-dismissible.fade.show.shadow-sm.mb-4(role='alert')
                .d-flex.align-items-center
                  i.bi.bi-check-circle-fill.me-2.fs-5
                  strong= successMessage
                button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

            form(action='/add-stock' method='POST' novalidate)
              .row.g-3
                .col-md-3
                  label.form-label Product Name
                  select.form-select(
                    name='productname' 
                    required
                    class=fieldErrors && fieldErrors.productname ? 'is-invalid' : ''
                  )
                    option(value='') Select Product
                    option Cement iiN
                    option Cement iiiN
                    option Iron Bars 10mm
                    option Iron Bars 12mm
                    option Iron Bars 16mm
                    option Nails 1 Inch
                    option Nails 2 Inch
                    option Nails 3 Inch
                    option Nails 4 Inch
                    option Nails 5 Inch
                    option Wheelbarrows
                    option Wire Mesh
                    option Barbed Wire
                    option Iron Sheets
                  if fieldErrors && fieldErrors.productname
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.productname

                .col-md-3
                  label.form-label Quantity
                  input.form-control(
                    type='number' 
                    name='quantity' 
                    required
                    value=quantity || ''
                    class=fieldErrors && fieldErrors.quantity ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.quantity
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.quantity

                .col-md-3
                  label.form-label Unit Cost (UGX)
                  input.form-control(
                    type='number' 
                    name='unitcost' 
                    required
                    value=unitcost || ''
                    class=fieldErrors && fieldErrors.unitcost ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.unitcost
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.unitcost

                .col-md-3
                  label.form-label Selling Price
                  input.form-control(
                    type='number' 
                    name='sellingPrice' 
                    required
                    value=sellingPrice || ''
                    class=fieldErrors && fieldErrors.sellingPrice ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.sellingPrice
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.sellingPrice

                .col-md-3
                  label.form-label Supplier Name
                  input.form-control(
                    type='text' 
                    name='suppliername' 
                    required
                    value=suppliername || ''
                    class=fieldErrors && fieldErrors.suppliername ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.suppliername
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.suppliername

                .col-md-3
                  label.form-label Supplier Phone               
                  input.form-control(
                    type="tel" 
                    name="supplierphone" 
                    id="customerPhoneInput" 
                    placeholder="+256700000000"
                    value=supplierphone || ''
                    minlength="13"
                    maxlength="13" 
                    pattern="^\\+256[0-9]{9}$" 
                    title="Phone number must start with +256 followed by exactly 9 digits (e.g. +256772123456)"
                    required
                    class=fieldErrors && fieldErrors.supplierphone ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.supplierphone
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.supplierphone


                .col-md-3
                  label.form-label Factory Name
                  input.form-control(
                    type='text' 
                    name='factoryname' 
                    required
                    value=factoryname || ''
                    class=fieldErrors && fieldErrors.factoryname ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.factoryname
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.factoryname

                .col-md-3
                  label.form-label Payment Status
                  select.form-select(
                    name='paymentstatus' 
                    required
                    class=fieldErrors && fieldErrors.paymentstatus ? 'is-invalid' : ''
                  )
                    option(value='') Select Status
                    option(value='Cash At Hand') Cash At Hand
                    option(value='Mobile Money') Mobile Money
                    option(value='Bank') Bank
                  if fieldErrors && fieldErrors.paymentstatus
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.paymentstatus

                .col-12.mt-4
                  button.st-btn-dark.w-100(type='submit')
                    i.bi.bi-plus-circle.me-2
                    | Add Stock Item

      // TABLE
      .row
        .col-12
          .card.st-card-style.p-4
            h5.st-accent-text Inventory Records

            .table-responsive
              table.table.table-hover.align-middle
                thead
                  tr.text-uppercase.text-secondary
                    th Product
                    th Qty
                    th Unit Cost
                    th Selling
                    th Total Paid
                    th Supplier
                    th Phone
                    th Factory
                    th Payment
                    th Date
                    th Status
                    th Action

                tbody
                  if stocks && stocks.length > 0
                    each stock in stocks
                      tr
                        td.fw-bold= stock.productname
                        td= stock.quantity
                        td UGX #{(Number(stock.unitcost) || 0).toLocaleString()}
                        td UGX #{(Number(stock.sellingPrice) || 0).toLocaleString()}
                        td UGX #{(Number(stock.totalpaid) || 0).toLocaleString()}
                        td= stock.suppliername
                        td= stock.supplierphone
                        td= stock.factoryname
                        td
                          if stock.paymentstatus === 'Cash'
                            span.badge.bg-success Cash
                          else if stock.paymentstatus === 'Mobile Money'
                            span.badge.bg-primary Mobile Money
                          else if stock.paymentstatus === 'Bank'
                            span.badge.bg-dark Bank
                          else
                            span.badge.bg-secondary= stock.paymentstatus
                        td
                          small First: #{stock.dateReceived.toDateString()}
                          br
                          small.text-muted Last: #{stock.lastRestocked.toDateString()}
                        td
                          if Number(stock.quantity) < 20
                            span.st-low-alert Low Stock
                          else
                            span.badge.bg-success Healthy
                        td
                          .d-flex.gap-2
                            a.btn.btn-sm.btn-outline-dark(href='/edit-stock/' + stock._id)
                              i.bi.bi-pencil
                            a.btn.btn-sm.btn-danger(
                              href='/delete-stock/' + stock._id
                              onclick="return confirm('Delete this stock item?')"
                            )
                              i.bi.bi-trash
                  else
                    tr
                      td.text-center(colspan='12') No stock records found