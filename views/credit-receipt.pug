doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Receipt - NYONDO HARDWARE
    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    style.
      :root {
        --color-charcoal: #212529;    /* Deep Charcoal (Rich, Premium Base) */
        --color-teal: #0d9488;        /* Vibrant Teal (Action / Accent Token) */
        --color-silver: #f1f3f5;      /* Polished Silver (Workspace Background) */
      }
      body {
        background-color: var(--color-silver);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--color-charcoal);
      }
      .receipt-card {
        max-width: 600px;
        margin: auto;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        background: #ffffff;
      }
      .title {
        color: var(--color-charcoal);
        font-weight: 800;
        letter-spacing: 0.5px;
      }
      .brand-highlight {
        color: var(--color-teal);
        font-weight: bold;
      }
      .receipt-divider {
        border-top: 2px dashed #dee2e6;
        opacity: 1;
        margin: 1.5rem 0;
      }
      .btn-print {
        background: var(--color-charcoal);
        color: white;
        border: 1px solid var(--color-charcoal);
        font-weight: 600;
        transition: 0.2s ease-in-out;
      }
      .btn-print:hover {
        background: var(--color-teal);
        color: white;
        border-color: var(--color-teal);
      }
      .text-gain {
        color: var(--color-teal); /* Unified Brand Teal for Financial Clear States */
      }
      .text-loss {
        color: var(--color-charcoal); /* Crisp Structural Charcoal for Remaining Balances */
      }
      /* Clean, Consistent Neutral and Primary Token Badges */
      .badge-clear {
        background-color: var(--color-teal);
        color: white;
      }
      .badge-pending {
        background-color: transparent;
        color: var(--color-charcoal);
        border: 1px solid var(--color-charcoal);
      }
      @media print {
        body {
          background-color: #ffffff;
        }
        .receipt-card {
          box-shadow: none;
          border: none;
          padding: 0 !important;
          margin: 0 auto;
        }
        .btn-print, .workflow-menu {
          display: none !important;
        }
      }
  body
    .container.py-5
      .card.receipt-card.p-5
        h2.text-center.title
          | NYONDO 
          span(style='color: var(--color-teal);') HARDWARE
        h6.text-center.text-muted.mb-4.fw-bold(style='letter-spacing: 1px;') TRANSACTION RECEIPT
        
        .receipt-divider

        p
          strong Receipt Number:
          |  #{deposit.receiptNumber}
        p
          strong Customer:
          |  #{deposit.customer ? deposit.customer.fullName : 'Deleted Customer'}
        p
          strong Phone:
          |  #{deposit.customer ? deposit.customer.phone : 'N/A'}
        p
          strong Item/Activity:
          |  #{deposit.item}
        p
          strong Quantity:
          |  #{deposit.quantity}
        p
          strong Unit Price:
          |  UGX #{deposit.unitPrice.toLocaleString()}
        p
          strong Transport Fee:
          |  UGX #{deposit.transportFee.toLocaleString()}
        p
          strong Total Amount (This Order):
          span.brand-highlight
            |  UGX #{deposit.totalPrice.toLocaleString()}
        p
          strong Amount Paid:
          span.text-gain.fw-bold
            |  UGX #{deposit.amount.toLocaleString()}
        p
          strong Outstanding Balance for Order:
          if deposit.balance <= 0
            span.text-gain.fw-bold  CLEARED
          else
            span.text-loss.fw-bold  UGX #{deposit.balance.toLocaleString()}
        
        if deposit.customer
          p
            strong Customer Grand Total Balance Due:
            span.fw-bold(style='color: var(--color-charcoal);')
              |  UGX #{deposit.customer.balance.toLocaleString()}
        p
          strong Status:
          if deposit.status === 'CLEAR' || deposit.balance <= 0
            span.badge.badge-clear.px-2.py-1.ms-1 CLEAR
          else
            span.badge.badge-pending.px-2.py-1.ms-1 PENDING
        p
          strong Payment Method:
          |  #{deposit.paymentMethod}
        p
          strong Date:
          |  #{new Date(deposit.createdAt).toLocaleDateString()}

        button.btn.btn-print.w-100.mt-4.py-2(onclick='window.print()') 🖨️ Print Receipt

      //- WORKFLOW NAVIGATION ACTIONS PANEL (Hidden automatically during print)
      .container.mt-4.workflow-menu(style="max-width: 600px; padding: 0;")
        .card.p-3.border-0.shadow-sm(style="background-color: var(--color-charcoal); border-radius: 12px; border-bottom: 3px solid var(--color-teal) !important;")
          p.text-center.text-white.small.fw-bold.text-uppercase.mb-3 Next Action Workflow Menu
          .d-flex.flex-wrap.gap-2.justify-content-center
            a.btn.btn-sm.btn-light.fw-semibold(href='/credit') 📋 View Customer Ledger List
            if deposit.customer
              a.btn.btn-sm.fw-semibold(href='/deposit/' + deposit.customer._id, style="background-color: var(--color-teal); color: #ffffff;") 💰 Collect Another Top-Up Payment