doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Login - NYONDOStock
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')
    link(rel='stylesheet' href='/css/responsive.css')
    style.
      :root {
        --color-charcoal: #212529;    /* Deep Charcoal Base */
        --color-teal: #0d9488;        /* Vibrant Teal Accent */
        --color-silver: #f1f3f5;      /* Polished Silver Background */
      }

      body {
        background-color: var(--color-silver) !important;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
        font-family: sans-serif;
      }
      
      .login-card {
        background: var(--color-charcoal) !important;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      }
      
      .brand-title {
        font-weight: 800;
        color: var(--color-silver);
        text-align: center;
        margin-bottom: 5px;
      }
      
      .brand-title span {
        color: var(--color-teal);
      }
      
      .form-label {
        color: var(--color-silver);
        font-weight: 600;
        font-size: 0.9rem;
      }
      
      .form-control {
        border: 2px solid var(--color-silver);
        padding: 12px;
        background-color: #fff;
      }
      
      .form-control:focus {
        border-color: var(--color-teal);
        box-shadow: none;
      }

      /* Unified Action Components */
      .btn-nyondo {
        background-color: var(--color-teal) !important;
        border: none !important;
        color: white !important;
        font-weight: 700;
        padding: 14px;
        width: 100%;
        margin-top: 10px;
        transition: background 0.2s ease;
      }
      
      .btn-nyondo:hover {
        background-color: #0f766e !important;
      }
      
      .link-nyondo {
        color: var(--color-teal);
        transition: color 0.2s ease;
      }

      .link-nyondo:hover {
        color: #0f766e;
      }

      .footer-text {
        text-align: center;
        margin-top: 20px;
        color: #9CA3AF;
        font-size: 0.8rem;
      }

  body
    .login-card
      h2.brand-title
        | NYONDO 
        span STOCK
      p.text-center.text-muted.small.mb-4 Inventory Management System
      
      if error
        p.text-danger.text-center #{error}
        
      form(action='/login' method='post')
        .mb-3
          label.form-label Email Address
          input.form-control(type='email' name='email' placeholder='admin@nyondo.com' required)
        .mb-4
          label.form-label Password
          input.form-control(type='password' name='password' placeholder='••••••••' required)
          
        button.btn.btn-nyondo(type='submit') SIGN IN
        
        .text-center.mt-3
          a.text-decoration-none.small.link-nyondo(href='#') Forgot Password?
          
      .footer-text
        | © 2026 NYONDO General Hardware LTD