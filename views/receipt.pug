doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Sales Receipt - NYONDO General Hardware LTD

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --primary-navy: #0f172a;
        --accent-orange: #f97316;
        --charcoal: #1e293b;
        --light-bg: #f8fafc;
      }

      body {
        background-color: var(--light-bg);
        color: var(--charcoal);
      }

      .btn-primary {
        background-color: var(--primary-navy);
        border-color: var(--primary-navy);
      }

      .btn-warning {
        background-color: var(--accent-orange);
        border-color: var(--accent-orange);
        color: white;
      }

      .btn-success {
        background-color: var(--charcoal);
        border-color: var(--charcoal);
      }

      .receipt-container {
        max-width: 800px;
        margin: 0 auto;
        border: 2px solid #000;
        padding: 20px;
        font-family: Arial, sans-serif;
        background-color: white;
      }

      .receipt-header {
        text-align: center;
        border-bottom: 2px dashed #000;
        padding-bottom: 15px;
        margin-bottom: 20px;
      }

      .receipt-title {
        font-size: 24px;
        font-weight: bold;
        text-transform: uppercase;
      }

      .receipt-details {
        display: flex;
        justify-content: space-between;
        margin-bottom: 20px;
        font-size: 14px;
      }

      .receipt-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
      }

      .receipt-table th {
        border-bottom: 1px solid #000;
        padding: 8px 0;
        text-align: left;
      }

      .receipt-table td {
        padding: 8px 0;
        border-bottom: 1px solid #ddd;
      }

      .total-row {
        font-weight: bold;
        border-top: 2px solid #000;
        border-bottom: 2px solid #000;
      }

      .payment-method {
        margin-top: 20px;
        padding-top: 10px;
        border-top: 1px dashed #000;
      }

      .receipt-footer {
        margin-top: 30px;
        text-align: center;
        font-size: 12px;
      }

      .thank-you {
        font-weight: bold;
        margin-top: 20px;
      }

      @media print {

        body {
          background: none;
        }

        .no-print {
          display: none;
        }

        .receipt-container {
          border: none;
          padding: 0;
        }
      }

  body

    .container.py-4

      .d-flex.justify-content-between.mb-4.no-print

        button.btn.btn-secondary(
          onclick='window.history.back()'
        )

          i.bi.bi-arrow-left

          | Back

        button.btn.btn-primary(
          onclick='window.print()'
        )

          i.bi.bi-printer

          | Print Receipt

      .receipt-container

        // HEADER
        .receipt-header

          .receipt-title
            | NYONDO STOCK General Hardware LTD

          .receipt-address
            | Nansana, Wakiso District - Katooke Road

          .receipt-contact
            | Tel: +256 414 123456

          .receipt-contact
            | VAT No: URA-123456789

        // DETAILS
        .receipt-details

          div

            strong Receipt No:
            | RCPT-#{sale._id.toString().slice(-6).toUpperCase()}

            br

            strong Date:
            | #{new Date(sale.createdAt).toLocaleDateString()}

            br

            strong Time:
            | #{new Date(sale.createdAt).toLocaleTimeString()}

          div

            strong Customer:
            | #{sale.customerName}

            br

            strong Contact:
            | #{sale.customerContact}

        // TABLE
        table.receipt-table

          thead

            tr
              th Item
              th Qty
              th Unit Price (UGX)
              th Total (UGX)

          tbody

            tr

              td= sale.product

              td= sale.quantity

              td
                | #{(sale.unitPrice || 0).toLocaleString()}

              td
                | #{(sale.total || 0).toLocaleString()}

          tfoot

            tr.total-row

              td.text-end(colspan='3')
                | TOTAL:

              td
                | UGX #{(sale.total || 0).toLocaleString()}

        // PAYMENT SECTION
        .payment-method

          strong Payment Method:
          | #{sale.paymentMethod}

          br

          strong Transport Fee:
          | UGX #{(sale.transportFee || 0).toLocaleString()}

          br

          strong Delivery Distance:
          | #{sale.deliveryDistance || 0} KM

        // FOOTER
        .receipt-footer

          .thank-you
            | THANK YOU FOR YOUR BUSINESS!

          div
            | Goods sold are not returnable unless defective

          div
            | Please present this receipt for any inquiries

          div
            | System generated receipt - No signature required

      // BUTTONS
      .d-flex.justify-content-center.gap-3.mt-4.no-print

        button.btn.btn-success

          i.bi.bi-envelope

          | Email Receipt

        button.btn.btn-primary

          i.bi.bi-whatsapp

          | Send via WhatsApp

        

    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )