doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sales Receipt - NYONDO General Hardware LTD
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')
    style.
      :root {
        --primary-navy: #0f172a;
        --accent-orange: #f97316;
        --charcoal: #1e293b;
        --light-bg: #f8fafc;
      }
      body { 
        background-color: var(--light-bg); 
        color: var(--charcoal); 
        font-family: 'Segoe UI', Arial, sans-serif;
      }
      .btn-navy { 
        background-color: var(--primary-navy); 
        border-color: var(--primary-navy); 
        color: #fff;
      }
      .btn-navy:hover {
        background-color: #1e293b;
        border-color: #1e293b;
        color: #fff;
      }
      .receipt-container { 
        max-width: 800px; 
        margin: 0 auto; 
        border: 1px solid #cbd5e1; 
        border-top: 6px solid var(--primary-navy);
        padding: 40px; 
        background-color: white; 
        border-radius: 8px;
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      }
      .receipt-header { 
        text-align: center; 
        border-bottom: 2px dashed #cbd5e1; 
        padding-bottom: 20px; 
        margin-bottom: 25px; 
      }
      .receipt-title { 
        font-size: 26px; 
        font-weight: 800; 
        color: var(--primary-navy);
        letter-spacing: -0.5px;
      }
      .receipt-subtitle {
        color: var(--accent-orange);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1px;
        margin-bottom: 10px;
      }
      .receipt-details { 
        display: flex; 
        justify-content: space-between; 
        margin-bottom: 25px; 
        font-size: 14px; 
        line-height: 1.6;
      }
      .receipt-table { 
        width: 100%; 
        border-collapse: collapse; 
        margin-bottom: 25px; 
      }
      .receipt-table th { 
        border-bottom: 2px solid var(--primary-navy); 
        padding: 10px 0; 
        text-align: left; 
        font-weight: 700;
        color: var(--primary-navy);
      }
      .receipt-table td { 
        padding: 12px 0; 
        border-bottom: 1px solid #e2e8f0; 
      }
      .total-row { 
        font-weight: bold; 
        border-top: 2px solid var(--primary-navy); 
      }
      .grand-total-text {
        color: var(--accent-orange);
        font-weight: 800;
      }
      .payment-method { 
        margin-top: 25px; 
        padding-top: 15px; 
        border-top: 1px dashed #cbd5e1; 
        font-size: 14px;
      }
      .receipt-footer { 
        margin-top: 40px; 
        text-align: center; 
        font-size: 13px; 
        color: #64748b;
      }
      @media print {
        body { background: none; color: #000; }
        .no-print { display: none !important; }
        .receipt-container { border: none; padding: 0; box-shadow: none; max-width: 100%; }
        .receipt-table th { border-bottom: 2px solid #000; color: #000; }
        .receipt-title { color: #000; }
        .grand-total-text { color: #000; }
      }

  body
    .container.py-4
      // TOP BUTTONS
      .d-flex.justify-content-between.mb-4.no-print
        button.btn.btn-secondary(onclick='window.history.back()')
          i.bi.bi-arrow-left.me-2
          | Back
        button.btn.btn-navy(onclick='window.print()')
          i.bi.bi-printer.me-2
          | Print Receipt

      .receipt-container
        // HEADER
        .receipt-header
          .receipt-subtitle OFFICIAL SALES RECEIPT
          .receipt-title NYONDO General Hardware LTD
          .text-muted.small.mt-1
            | Nansana, Wakiso District - Katooke Road
            br
            | Tel: +256 414 123456 | VAT No: URA-123456789

        // INVOICE DETAILS
        .receipt-details
          div
            strong Receipt No: 
            | RCPT-#{sale._id.toString().slice(-6).toUpperCase()}
            br
            strong Date: 
            | #{new Date(sale.createdAt).toLocaleDateString()}
            br
            strong Time: 
            | #{new Date(sale.createdAt).toLocaleTimeString()}
          div.text-end
            strong Customer: 
            | #{sale.customerName}
            br
            strong Contact: 
            | #{sale.customerContact}

        // ITEMS MATRIX
        table.receipt-table
          thead
            tr
              th Item Description
              th.text-center Qty
              th.text-end Unit Price (UGX)
              th.text-end Total (UGX)
          tbody
            each item in sale.items
              tr
                td= item.product
                td.text-center= item.quantity
                td.text-end #{item.sellingPrice.toLocaleString()}
                td.text-end #{item.itemTotal.toLocaleString()}
          tfoot
            tr
              td.text-end(colspan='3').text-muted Subtotal:
              td.text-end UGX #{sale.subTotal.toLocaleString()}
            tr
              td.text-end(colspan='3').text-muted Transport Fee:
              td.text-end UGX #{sale.transportFee.toLocaleString()}
            tr.total-row
              td.text-end(colspan='3') GRAND TOTAL:
              td.text-end.grand-total-text UGX #{sale.total.toLocaleString()}

        // FOOTER AND METADATA
        .payment-method.row
          .col-sm-6
            strong Payment Method: 
            span.badge.bg-light.text-dark.border.ms-1 #{sale.paymentMethod}
          .col-sm-6.text-sm-end
            strong Delivery Radius: 
            | #{sale.deliveryDistance} KM

        .receipt-footer
          .fw-bold.text-dark THANK YOU FOR YOUR BUSINESS!
          div Goods sold are not returnable unless defective.
          div.small.text-muted.mt-1 System generated receipt - No signature required.

      // UTILITY ACTIONS
      .d-flex.justify-content-center.gap-3.mt-4.no-print
        button.btn.btn-outline-secondary
          i.bi.bi-envelope.me-2
          | Email Receipt
        button.btn.btn-outline-success
          i.bi.bi-whatsapp.me-2
          | Send via WhatsApp

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')