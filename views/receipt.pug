doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sales Receipt - NYONDO General Hardware LTD
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css' rel='stylesheet')
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css')
    style.
      :root {
        --primary-navy: #0f172a;
        --accent-orange: #f97316;
        --charcoal: #1e293b;
        --light-bg: #f8fafc;
      }
      body { background-color: var(--light-bg); color: var(--charcoal); }
      .btn-primary { background-color: var(--primary-navy); border-color: var(--primary-navy); }
      .receipt-container { max-width: 800px; margin: 0 auto; border: 2px solid #000; padding: 20px; font-family: Arial, sans-serif; background-color: white; }
      .receipt-header { text-align: center; border-bottom: 2px dashed #000; padding-bottom: 15px; margin-bottom: 20px; }
      .receipt-title { font-size: 24px; font-weight: bold; text-transform: uppercase; }
      .receipt-details { display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 14px; }
      .receipt-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
      .receipt-table th { border-bottom: 1px solid #000; padding: 8px 0; text-align: left; }
      .receipt-table td { padding: 8px 0; border-bottom: 1px solid #ddd; }
      .total-row { font-weight: bold; border-top: 2px solid #000; }
      .payment-method { margin-top: 20px; padding-top: 10px; border-top: 1px dashed #000; }
      .receipt-footer { margin-top: 30px; text-align: center; font-size: 12px; }
      @media print {
        body { background: none; }
        .no-print { display: none; }
        .receipt-container { border: none; padding: 0; }
      }

  body
    .container.py-4
      .d-flex.justify-content-between.mb-4.no-print
        button.btn.btn-secondary(onclick='window.history.back()')
          i.bi.bi-arrow-left.me-2
          | Back
        button.btn.btn-primary(onclick='window.print()')
          i.bi.bi-printer.me-2
          | Print Receipt

      .receipt-container
        // HEADER
        .receipt-header
          .receipt-title NYONDO STOCK General Hardware LTD
          .receipt-address Nansana, Wakiso District - Katooke Road
          .receipt-contact Tel: +256 414 123456
          .receipt-contact VAT No: URA-123456789

        // INVOICE DETAILS
        .receipt-details
          div
            strong Receipt No: 
            | RCPT-#{sale._id.toString().slice(-6).toUpperCase()}
            br
            strong Date: 
            | #{new Date(sale.createdAt).toLocaleDateString()}
            br
            strong Time: 
            | #{new Date(sale.createdAt).toLocaleTimeString()}
          div
            strong Customer: 
            | #{sale.customerName}
            br
            strong Contact: 
            | #{sale.customerContact}

        // ITEMS MATRIX
        table.receipt-table
          thead
            tr
              th Item Description
              th.text-center Qty
              th.text-end Unit Price (UGX)
              th.text-end Total (UGX)
          tbody
            each item in sale.items
              tr
                td= item.product
                td.text-center= item.quantity
                td.text-end #{item.sellingPrice.toLocaleString()}
                td.text-end #{item.itemTotal.toLocaleString()}
          tfoot
            tr
              td.text-end(colspan='3') Subtotal:
              td.text-end UGX #{sale.subTotal.toLocaleString()}
            tr
              td.text-end(colspan='3') Transport Fee:
              td.text-end UGX #{sale.transportFee.toLocaleString()}
            tr.total-row
              td.text-end(colspan='3') GRAND TOTAL:
              td.text-end.text-primary UGX #{sale.total.toLocaleString()}

        // FOOTER AND METADATA
        .payment-method
          strong Payment Method: 
          | #{sale.paymentMethod}
          br
          strong Delivery Radius: 
          | #{sale.deliveryDistance} KM

        .receipt-footer
          .fw-bold.mt-2 THANK YOU FOR YOUR BUSINESS!
          div Goods sold are not returnable unless defective.
          div System generated receipt - No signature required.

      .d-flex.justify-content-center.gap-3.mt-4.no-print
        button.btn.btn-success
          i.bi.bi-envelope.me-2
          | Email Receipt
        button.btn.btn-primary
          i.bi.bi-whatsapp.me-2
          | Send via WhatsApp