doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Staff Management - NYONDO STOCK

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --brand-navy: #212529;       /* Deep Charcoal Base */
        --brand-orange: #0d9488;     /* Vibrant Teal Accent */
        --light-bg: #f1f3f5;         /* Polished Silver Background */
        --charcoal: #343a40;          /* Subdued Body Text */
      }

      body {
        background-color: var(--light-bg);
        color: var(--charcoal);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: #ffffff;
      }

      .header {
        background: var(--brand-navy) !important;
        border-bottom: 4px solid var(--brand-orange) !important;
        color: white;
        padding: 20px;
        border-radius: 12px 12px 0 0;
      }

      .table thead {
        background-color: #f8f9fa;
        color: var(--brand-navy);
      }

      .badge-role {
        background-color: var(--brand-navy) !important;
        color: #ffffff !important;
        font-weight: 500;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.4em 0.8em;
      }

      .btn-danger-custom {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 12px;
        border: none;
        transition: background 0.2s ease;
      }

      .btn-danger-custom:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
        color: #ffffff !important;
      }

  body

    .container.mt-5

      .card

        //- UPDATED HEADER: Added flex spacing to position the back button beautifully
        .header.d-flex.justify-content-between.align-items-center
          h3.mb-0
            i.bi.bi-people.me-2
            | Staff Management
          
          //- NEW BACK BUTTON
          a.btn.btn-outline-light.btn-sm.fw-semibold.px-3(href='/admin')
            i.bi.bi-arrow-left.me-2
            | Dashboard

        .card-body

          if staffs && staffs.length > 0

            .table-responsive

              table.table.table-hover.align-middle

                thead
                  tr
                    th Full Name
                    th Email
                    th Phone
                    th NIN
                    th Role
                    th Action

                tbody

                  each staff in staffs

                    tr

                      td.fw-semibold= staff.fullname
                      td= staff.email
                      td= staff.phonenumber
                      td= staff.nin

                      td
                        span.badge.badge-role= staff.role

                      td
                        form(
                          action='/delete-staff/' + staff._id
                          method='POST'
                          onsubmit='return confirm("Are you sure you want to delete this staff?")'
                          style='display: inline;'
                        )
                          button.btn.btn-danger-custom.btn-sm(type='submit')
                            i.bi.bi-trash

          else

            p.text-muted.text-center.mt-3
              | No staff registered yet

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')