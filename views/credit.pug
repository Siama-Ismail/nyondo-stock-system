doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Credit Dashboard - NYONDO HARDWARE

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    style.
      :root {
        --primary-navy: #111827;
        --accent-orange: #FD7E14;
        --light-bg: #E5E7EB;
      }

      body {
        background: var(--light-bg);
        font-family: sans-serif;
        color: var(--primary-navy);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
      }

      .btn-nyondo {
        background: var(--accent-orange);
        color: white;
        border: none;
        font-weight: 600;
      }

      .btn-nyondo:hover {
        background: #e46f0b;
        color: white;
      }

      .table thead {
        background: var(--primary-navy);
        color: white;
      }

      .badge-clear {
        background: #198754;
      }

      .badge-pending {
        background: #ffc107;
        color: #111827;
      }

  body

    .container.py-5

      .d-flex.justify-content-between.align-items-center.mb-4

        h2.fw-bold CREDIT CUSTOMERS

      // ======================================
      // REGISTER CUSTOMER
      // ======================================
      .card.p-4.mb-5

        h5.fw-bold.mb-4 Register Credit Customer

        form(
          action='/add-credit-customer'
          method='POST'
        )

          .row

            .col-md-6.mb-3
              label.form-label Full Name
              input.form-control(
                type='text'
                name='fullName'
                required
              )

            .col-md-6.mb-3
              label.form-label NIN
              input.form-control(
                type='text'
                name='nin'
                required
              )

            .col-md-6.mb-3
              label.form-label Phone
              input.form-control(
                type='text'
                name='phone'
                required
              )

            .col-md-6.mb-3
              label.form-label Email
              input.form-control(
                type='email'
                name='email'
                required
              )

            .col-md-6.mb-3
              label.form-label Address
              input.form-control(
                type='text'
                name='address'
                required
              )

            .col-md-6.mb-3
              label.form-label Distance (KM)
              input.form-control(
                type='number'
                name='distance'
                required
              )

            .col-md-6.mb-3
              label.form-label Occupation
              input.form-control(
                type='text'
                name='occupation'
                required
              )

            .col-md-6.mb-3
              label.form-label Employer
              input.form-control(
                type='text'
                name='employer'
                required
              )

            .col-md-12.mb-3
              label.form-label Next Of Kin
              input.form-control(
                type='text'
                name='nextOfKin'
                required
              )

          button.btn.btn-nyondo.w-100.mt-3(
            type='submit'
          ) Save Customer

      // ======================================
      // CUSTOMER LIST
      // ======================================
      .card.p-4.mb-5

        h5.fw-bold.mb-4 Customer Accounts

        .table-responsive

          table.table.table-bordered.table-hover.align-middle

            thead

              tr
                th Customer
                th Phone
                th Address
                th Balance
                th Status
                th Actions

            tbody

              if customers.length === 0

                tr
                  td.text-center(colspan='6')
                    | No customers found

              each customer in customers

                tr

                  td.fw-semibold
                    = customer.fullName

                  td
                    = customer.phone

                  td
                    = customer.address

                  td

                    if customer.balance > 0
                      span.text-danger.fw-bold
                        | UGX #{customer.balance.toLocaleString()}
                    else
                      span.text-success.fw-bold
                        | UGX 0

                  td

                    if customer.balance > 0
                      span.badge.badge-pending PENDING
                    else
                      span.badge.badge-clear CLEAR

                  td

                    .d-flex.flex-wrap.gap-2

                      a.btn.btn-sm.btn-nyondo(
                        href='/deposit/' + customer._id
                      ) Deposit

                      a.btn.btn-sm.btn-dark(
                        href='/customer-history/' + customer._id
                      ) History

      // ======================================
      // RECENT TRANSACTIONS
      // ======================================
      .card.p-4

        h5.fw-bold.mb-4 Recent Deposit Transactions

        .table-responsive

          table.table.table-bordered.table-hover.align-middle

            thead

              tr
                th Receipt
                th Customer
                th Item
                th Paid
                th Balance
                th Status
                th Date
                th Actions

            tbody

              if deposits.length === 0

                tr
                  td.text-center(colspan='8')
                    | No transactions found

              each deposit in deposits

                tr

                  td
                    = deposit.receiptNumber

                  td
                    = deposit.customer ? deposit.customer.fullName : 'Deleted Customer'

                  td
                    = deposit.item

                  td.text-success.fw-bold
                    | UGX #{deposit.amount.toLocaleString()}

                  td

                    if deposit.balance > 0
                      span.text-danger.fw-bold
                        | UGX #{deposit.balance.toLocaleString()}
                    else
                      span.text-success.fw-bold
                        | UGX 0

                  td

                    if deposit.status === 'CLEAR'
                      span.badge.badge-clear CLEAR
                    else
                      span.badge.badge-pending PENDING

                  td
                    = new Date(deposit.createdAt).toLocaleDateString()

                  td

                    .d-flex.flex-wrap.gap-2

                      a.btn.btn-sm.btn-outline-dark(
                        href='/credit-receipt/' + deposit._id
                      ) Receipt

                      a.btn.btn-sm.btn-warning(
                        href='/edit-credit/' + deposit._id
                      ) Edit

                      form(
                        action='/delete-credit/' + deposit._id
                        method='POST'
                        onsubmit="return confirm('Are you sure you want to delete this transaction?')"
                      )

                        button.btn.btn-sm.btn-danger(
                          type='submit'
                        ) Delete