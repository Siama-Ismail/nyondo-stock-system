doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Credit Dashboard - NYONDO HARDWARE

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
        padding-left: 260px;
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .btn-nyondo {
        background: var(--color-teal) !important;
        color: white !important;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e !important;
        color: white !important;
      }

      .btn-nyondo-secondary {
        background: var(--color-teal) !important;
        color: white !important;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo-secondary:hover {
        background: #0f766e !important;
        color: white !important;
      }

      .btn-outline-charcoal {
        color: var(--color-charcoal) !important;
        border: 2px solid var(--color-charcoal) !important;
        background: transparent !important;
        font-weight: 600;
      }

      .btn-outline-charcoal:hover {
        background: var(--color-charcoal) !important;
        color: white !important;
      }

      .btn-danger-custom {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
        font-weight: 600;
        border: none;
        transition: background 0.2s ease;
      }

      .btn-danger-custom:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
        color: #ffffff !important;
      }

      .table thead {
        background: var(--color-charcoal);
        color: white;
      }

      .badge-clear {
        background: var(--color-teal);
        color: white;
      }

      .badge-pending {
        background: transparent;
        color: var(--color-charcoal);
        border: 1px solid var(--color-charcoal);
      }

      .text-teal-gain {
        color: var(--color-teal);
      }

      .st-sidebar {
        width: 260px;
        height: 100vh;
        background-color: #212529;
        border-right: 3px solid #0d9488;
        position: fixed;
        top: 0;
        left: 0;
        padding: 20px;
        display: flex;
        flex-direction: column;
        z-index: 1000;
      }

      .st-sidebar .navbar-brand {
        font-size: 1.5rem;
        text-decoration: none;
        color: white;
        font-weight: 800;
        margin-bottom: 30px;
      }

      .st-sidebar .navbar-brand span {
        color: #0d9488;
      }

      .st-sidebar .nav-link {
        color: #caecf5;
        opacity: 0.85;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 8px;
        transition: 0.3s;
        display: flex;
        align-items: center;
        text-decoration: none;
      }

      .st-sidebar .nav-link:hover,
      .st-sidebar .nav-link.active {
        background-color: rgba(13, 148, 136, 0.15);
        color: #fff !important;
        opacity: 1;
      }

      .st-sidebar .nav-link.active {
        border-left: 4px solid #0d9488;
        border-radius: 0 8px 8px 0;
      }

  body

    .st-sidebar
      a.navbar-brand(href='/admin')
        | NYONDO
        span STOCK

      nav.nav.flex-column
        a.nav-link(href='/admin')
          i.bi.bi-speedometer2.me-2
          span Dashboard

        a.nav-link.active(href='/credit')
          i.bi.bi-cash-stack.me-2
          span Credit


        a.nav-link(href='/logout')
          i.bi.bi-box-arrow-right.me-2.text-danger
          span Logout

    .container.py-5

      .d-flex.justify-content-between.align-items-center.mb-4
        h2.fw-bold.mb-0 CREDIT CUSTOMERS
       
      .card.p-4.mb-5
        h5.fw-bold.mb-4 Register Credit Customer
        form(action='/add-credit-customer' method='POST')
          .row
            .col-md-6.mb-3
              label.form-label Full Name
              input.form-control(type='text' name='fullName' required)

            .col-md-6.mb-3
              label.form-label NIN
              input.form-control(type='text' name='nin' required)

            .col-md-6.mb-3
              label.form-label Phone
              input.form-control(type='tel' name='phone' required)

            .col-md-6.mb-3
              label.form-label Email
              input.form-control(type='email' name='email' required)

            .col-md-6.mb-3
              label.form-label Address
              input.form-control(type='text' name='address' required)

            .col-md-6.mb-3
              label.form-label Distance (KM)
              input.form-control(type='number' name='distance' required)

            .col-md-6.mb-3
              label.form-label Occupation
              input.form-control(type='text' name='occupation' required)

            .col-md-6.mb-3
              label.form-label Employer
              input.form-control(type='text' name='employer' required)

            .col-md-12.mb-3
              label.form-label Next Of Kin
              input.form-control(type='text' name='nextOfKin' required)

          button.btn.btn-nyondo.w-100(type='submit') Save Customer

      .card.p-4.mb-5
        h5.fw-bold.mb-4 Customer Accounts
        .table-responsive
          table.table.table-bordered.table-hover.align-middle
            thead
              tr
                th Customer
                th Phone
                th Address
                th Balance
                th Status
                th Actions
            tbody
              if !customers || customers.length === 0
                tr
                  td.text-center(colspan='6') No customers found
              else
                each customer in customers
                  tr
                    td #{customer.fullName}
                    td #{customer.phone}
                    td #{customer.address}
                    td UGX #{customer.balance.toLocaleString()}
                    td
                      if customer.balance > 0
                        span.badge.badge-pending PENDING
                      else
                        span.badge.badge-clear CLEAR
                    td
                      a.btn.btn-sm.btn-nyondo(href='/deposit/' + customer._id) Deposit
                      a.btn.btn-sm.btn-nyondo-secondary(href='/customer-history/' + customer._id) History

      .card.p-4
        h5.fw-bold.mb-4 Recent Deposit Transactions
        .table-responsive
          table.table.table-bordered.table-hover.align-middle
            thead
              tr
                th Receipt
                th Customer
                th Item
                th Paid
                th Balance
                th Status
                th Date
                th Actions
            tbody
              if !deposits || deposits.length === 0
                tr
                  td.text-center(colspan='8') No transactions found
              else
                each deposit in deposits
                  tr
                    td #{deposit.receiptNumber}
                    td #{deposit.customer ? deposit.customer.fullName : 'Deleted Customer'}
                    td #{deposit.item}
                    td UGX #{deposit.amount.toLocaleString()}
                    td UGX #{deposit.balance.toLocaleString()}
                    td #{deposit.status}
                    td #{new Date(deposit.createdAt).toLocaleDateString()}
                    td
                      a.btn.btn-sm.btn-nyondo-secondary(href='/credit-receipt/' + deposit._id) Receipt
                      a.btn.btn-sm.btn-nyondo-secondary(href='/edit-credit/' + deposit._id) Edit
                      form(method='POST' action='/delete-credit/' + deposit._id style='display:inline')
                        button.btn.btn-sm.btn-danger-custom(type='submit') Delete