doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Credit Dashboard - NYONDO HARDWARE

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --color-charcoal: #212529;
        --color-teal: #0d9488;
        --color-silver: #f1f3f5;
      }

      body {
        background: var(--color-silver);
        font-family: sans-serif;
        color: var(--color-charcoal);
      }

      .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        background: white;
      }

      .btn-nyondo {
        background: var(--color-teal) !important;
        color: white !important;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo:hover {
        background: #0f766e !important;
        color: white !important;
      }

      .btn-nyondo-secondary {
        background: var(--color-teal) !important;
        color: white !important;
        border: none;
        font-weight: 600;
        transition: background 0.2s ease;
      }

      .btn-nyondo-secondary:hover {
        background: #0f766e !important;
        color: white !important;
      }

      .btn-outline-charcoal {
        color: var(--color-charcoal) !important;
        border: 2px solid var(--color-charcoal) !important;
        background: transparent !important;
        font-weight: 600;
      }

      .btn-outline-charcoal:hover {
        background: var(--color-charcoal) !important;
        color: white !important;
      }

      .btn-danger-custom {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
        font-weight: 600;
        border: none;
        transition: background 0.2s ease;
      }

      .btn-danger-custom:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
        color: #ffffff !important;
      }

      .table thead {
        background: var(--color-charcoal);
        color: white;
      }

      .badge-clear {
        background: var(--color-teal);
        color: white;
      }

      .badge-pending {
        background: transparent;
        color: var(--color-charcoal);
        border: 1px solid var(--color-charcoal);
      }
      
      .text-teal-gain {
        color: var(--color-teal);
      }

  body

    .container.py-5

      // TITLE AND BACK NAVIGATION ACTIONS
      .d-flex.justify-content-between.align-items-center.mb-4
        h2.fw-bold.mb-0 CREDIT CUSTOMERS
        a.btn.btn-outline-charcoal.px-3(href='/admin')
          i.bi.bi-arrow-left.me-2
          | Back to Dashboard

      // REGISTER CUSTOMER
      .card.p-4.mb-5
        h5.fw-bold.mb-4 Register Credit Customer
        form(
          action='/add-credit-customer'
          method='POST'
        )
          .row
            .col-md-6.mb-3
              label.form-label Full Name
              input.form-control(
                type='text'
                name='fullName'
                required
              )

            .col-md-6.mb-3
              label.form-label NIN
              input.form-control(
                type='text'
                name='nin'
                id='customerNINInput'
                placeholder='e.g., CM92012345XYZW'
                minlength='14'
                maxlength='14'
                pattern='^[A-Za-z0-9]{14}$'
                title='NIN must be exactly 14 characters long and contain only letters and numbers'
                style='text-transform: uppercase;'
                required
              )

            .col-md-6.mb-3
              label.form-label Phone
              input.form-control(
                type="tel" 
                name="phone" 
                id="customerPhoneInput" 
                placeholder="+256700000000"
                value="+256"
                minlength="13"
                maxlength="13" 
                pattern="^\\+256[0-9]{9}$" 
                title="Phone number must start with +256 followed by exactly 9 digits (e.g. +256772123456)"
                required
              )
            .col-md-6.mb-3
              label.form-label Email
              input.form-control(
                type='email'
                name='email'
                required
              )

            .col-md-6.mb-3
              label.form-label Address
              input.form-control(
                type='text'
                name='address'
                required
              )

            .col-md-6.mb-3
              label.form-label Distance (KM)
              input.form-control(
                type='number'
                name='distance'
                required
              )

            .col-md-6.mb-3
              label.form-label Occupation
              input.form-control(
                type='text'
                name='occupation'
                required
              )

            .col-md-6.mb-3
              label.form-label Employer
              input.form-control(
                type='text'
                name='employer'
                required
              )

            .col-md-12.mb-3
              label.form-label Next Of Kin
              input.form-control(
                type='text'
                name='nextOfKin'
                required
              )

          button.btn.btn-nyondo.w-100.mt-3(
            type='submit'
          ) Save Customer

      // CUSTOMER LIST
      .card.p-4.mb-5
        h5.fw-bold.mb-4 Customer Accounts
        .table-responsive
          table.table.table-bordered.table-hover.align-middle
            thead
              tr
                th Customer
                th Phone
                th Address
                th Balance
                th Status
                th Actions
            tbody
              if !customers || customers.length === 0
                tr
                  td.text-center(colspan='6') No customers found
              else
                each customer in customers
                  tr
                    td.fw-semibold #{customer.fullName}
                    td #{customer.phone}
                    td #{customer.address}
                    td
                      if customer.balance > 0
                        span.text-dark.fw-bold UGX #{customer.balance.toLocaleString()}
                      else
                        span.text-teal-gain.fw-bold UGX 0
                    td
                      if customer.balance > 0
                        span.badge.badge-pending PENDING
                      else
                        span.badge.badge-clear CLEAR
                    td
                      .d-flex.flex-wrap.gap-2
                        a.btn.btn-sm.btn-nyondo(
                          href='/deposit/' + customer._id
                        ) Deposit
                        a.btn.btn-sm.btn-nyondo-secondary(
                          href='/customer-history/' + customer._id
                        ) History
                        form(
                          action='/delete-customer/' + customer._id
                          method='POST'
                          onsubmit="return confirm('Are you sure you want to delete this customer account? This cannot be undone.')"
                          style='display: inline;'
                        )
                          button.btn.btn-sm.btn-danger-custom(
                            type='submit'
                          ) Delete

      // RECENT TRANSACTIONS
      .card.p-4
        h5.fw-bold.mb-4 Recent Deposit Transactions
        .table-responsive
          table.table.table-bordered.table-hover.align-middle
            thead
              tr
                th Receipt
                th Customer
                th Item
                th Paid
                th Balance
                th Status
                th Date
                th Actions
            tbody
              if !deposits || deposits.length === 0
                tr
                  td.text-center(colspan='8') No transactions found
              else
                each deposit in deposits
                  tr
                    td #{deposit.receiptNumber}
                    td #{deposit.customer ? deposit.customer.fullName : 'Deleted Customer'}
                    td #{deposit.item}
                    td.text-teal-gain.fw-bold UGX #{deposit.amount.toLocaleString()}
                    td
                      if deposit.balance > 0
                        span.text-dark.fw-bold UGX #{deposit.balance.toLocaleString()}
                      else
                        span.text-teal-gain.fw-bold UGX 0
                    td
                      if deposit.status === 'CLEAR'
                        span.badge.badge-clear CLEAR
                      else
                        span.badge.badge-pending PENDING
                    td #{new Date(deposit.createdAt).toLocaleDateString()}
                    td
                      .d-flex.flex-wrap.gap-2
                        a.btn.btn-sm.btn-nyondo-secondary(
                          href='/credit-receipt/' + deposit._id
                        ) Receipt
                        a.btn.btn-sm.btn-nyondo-secondary(
                          href='/edit-credit/' + deposit._id
                        ) Edit
                        form(
                          action='/delete-credit/' + deposit._id
                          method='POST'
                          onsubmit="return confirm('Are you sure you want to delete this transaction?')"
                        )
                          button.btn.btn-sm.btn-danger-custom(
                            type='submit'
                          ) Delete