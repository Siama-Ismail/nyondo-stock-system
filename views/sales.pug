doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Sales - NYONDO Stock

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --brand-navy: #212529;       /* Deep Charcoal Base */
        --brand-orange: #0d9488;     /* Vibrant Teal Accent */
        --sidebar-hover: rgba(13, 148, 136, 0.15); /* Clean Translucent Teal Hover */
        --light-bg: #f1f3f5;         /* Polished Silver Background */
      }

      body {
        background-color: var(--light-bg);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        margin: 0;
      }

      .sidebar {
        background-color: var(--brand-navy);
        min-height: 100vh;
        position: fixed;
        border-right: 3px solid var(--brand-orange);
      }

      .brand-logo {
        color: #ffffff !important;
        font-weight: 800;
        font-size: 1.5rem;
        padding: 25px 20px;
        display: block;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
      }

      .nav-link {
        color: #caecf5 !important;
        opacity: 0.85;
        padding: 15px 25px;
        font-weight: 500;
        transition: all 0.2s ease;
      }

      .nav-link:hover {
        background-color: var(--sidebar-hover);
        color: #ffffff !important;
        opacity: 1;
      }

      .nav-link.active {
        background-color: rgba(13, 148, 136, 0.2);
        color: #ffffff !important;
        opacity: 1;
        border-left: 4px solid var(--brand-orange);
      }

      .main-content {
        margin-left: 16.666667%;
        padding: 40px;
      }

      .section-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 30px;
        margin-bottom: 30px;
        border: 1px solid #dee2e6;
      }

      .section-title {
        color: var(--brand-navy);
        font-weight: 800;
        border-bottom: 3px solid var(--brand-orange);
        display: inline-block;
        margin-bottom: 20px;
      }

      .btn-primary {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
        font-weight: 600;
      }

      .btn-primary:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      /* UNIFIED TABLE ACTION BUTTON OVERRIDES */
      .btn-warning {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
        font-weight: 600;
      }
      .btn-warning:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      .btn-outline-primary {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
      }
      .btn-outline-primary:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      .btn-danger {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
      }
      .btn-danger:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
      }

  body

    .container-fluid
      .row

        // ================= SIDEBAR =================
        nav.col-md-2.sidebar.d-none.d-md-block

          a.brand-logo(href='/dashboard')
            | NYONDO #[span(style="color: var(--brand-orange);") STOCK]

          .nav.flex-column.mt-2

            a.nav-link(href='/dashboard')
              i.bi.bi-speedometer2.me-2
              | Home 

            a.nav-link.active(href='/sales')
              i.bi.bi-cart-check.me-2
              | Sales

            a.nav-link(href='/logout')
              span.text-danger
                i.bi.bi-box-arrow-right.me-2
                | Logout


        // ================= MAIN CONTENT =================
        main.col-md-10.main-content

          // ================= SALES FORM =================
          .section-card

            h4.section-title
              | Record Sale

            //- NEW: DYNAMIC IN-PAGE ERROR BLOCK CATCHER
            if error
              .alert.alert-danger.alert-dismissible.fade.show.shadow-sm.mb-4(role='alert')
                .d-flex.align-items-center
                  i.bi.bi-exclamation-triangle-fill.me-2.fs-5
                  strong= error
                button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

            form(action='/add-sales' method='POST')

              h5.text-muted.mb-3.fs-6
                | Customer Information

              .row.g-3.mb-4

                .col-md-4
                  label.form-label Customer Name

                  input.form-control(
                    type='text'
                    name='customerName'
                    required
                  )

                .col-md-4
                  label.form-label Customer Contact
                  input.form-control(
                    type="tel" 
                    name="customerContact" 
                    id="customerPhoneInput" 
                    value=(oldData && oldData.customerContact ? oldData.customerContact : "+256") 
                    maxlength="13" 
                    pattern="^\\+256[0-9]{9}$" 
                    title="Phone number must start with +256 followed by exactly 9 digits"
                    class=(errors && errors.customerContact? 'is-invalid' : '')
                    required
                  )

                .col-md-4
                  label.form-label Payment Method

                  select.form-select(
                    name='paymentMethod'
                    required
                  )

                    option(value='Cash')
                      | Cash At Hand

                    option(value='Mobile Money')
                      | Mobile Money

                    option(value='Bank')
                      | Bank

                .col-md-4
                  label.form-label Delivery Distance (KM)

                  input.form-control(
                    type='number'
                    name='deliveryDistance'
                    required
                  )


              h5.text-muted.mb-3.fs-6
                | Products Ordered


              // ================= ITEM CONTAINER =================
              #items-container

                .row.g-3.item-row.mb-3

                  .col-md-8

                    label.form-label Product Name

                    select.form-select(
                      name='product'
                      required
                    )

                      option(value='')
                        | Select Product

                      if stocks && stocks.length

                        each stock in stocks

                          option(value=stock.productname)
                            | #{stock.productname} - Qty Available: #{stock.quantity} [UGX #{stock.sellingPrice.toLocaleString()}]

                      else

                        option(value='')
                          | No stock available


                  .col-md-3

                    label.form-label Quantity

                    input.form-control(
                      type='number'
                      name='quantity'
                      min='1'
                      required
                    )


                  .col-md-1.d-flex.align-items-end

                    button.btn.btn-outline-danger.w-100(
                      type='button'
                      onclick='removeRow(this)'
                    )
                      i.bi.bi-trash


              button.btn.btn-outline-secondary.btn-sm.mb-4(
                type='button'
                id='add-item-btn'
              )

                i.bi.bi-plus.me-1
                | Add Another Item


              button.btn.btn-primary.w-100(
                type='submit'
              )

                i.bi.bi-plus-circle.me-2
                | Add Sale & Print Receipt



          // ================= SALES TABLE =================
          .section-card

            h4.section-title
              | Sales Records

            .table-responsive

              table.table.table-hover.align-middle

                thead

                  tr
                    th Customer
                    th Contact
                    th Items Ordered
                    th Distance
                    th Transport
                    th Grand Total
                    th Date
                    th Action

                tbody

                  if sales && sales.length > 0

                    each sale in sales

                      tr

                        td.fw-bold
                          = sale.customerName

                        td
                          = sale.customerContact

                        td

                          span.badge.bg-dark
                            | #{sale.items ? sale.items.length : 0} Item(s)

                        td
                          | #{sale.deliveryDistance} KM


                        td

                          if sale.transportFee === 0

                            span.badge.bg-success
                              | Free

                          else

                            span.badge.bg-warning.text-dark
                              | UGX #{sale.transportFee.toLocaleString()}


                        td.fw-bold.text-success
                          | UGX #{sale.total.toLocaleString()}


                        td
                          = new Date(sale.createdAt).toLocaleDateString()


                        // ================= ACTION BUTTONS =================
                        td

                          // EDIT BUTTON
                          a.btn.btn-sm.btn-warning.me-1(
                            href='/edit-sales/' + sale._id
                            title='Edit Sale'
                          )
                            i.bi.bi-pencil-square

                          // RECEIPT BUTTON
                          a.btn.btn-sm.btn-outline-primary.me-1(
                            href='/receipt/' + sale._id
                            title='Print Receipt'
                          )
                            i.bi.bi-receipt

                          // DELETE BUTTON
                          a.btn.btn-sm.btn-danger(
                            href='/delete-sales/' + sale._id
                            onclick="return confirm('Delete this sale record?')"
                            title='Delete Sale'
                          )
                            i.bi.bi-trash


                  else

                    tr

                      td.text-center.py-4(colspan='8')
                        | No sales records found.



    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )

    script.
      // =========================
      // ADD NEW ITEM ROW
      // =========================
      document
        .getElementById('add-item-btn')
        .addEventListener('click', function() {

          const container =
            document.getElementById('items-container');

          const rows =
            container.querySelectorAll('.item-row');

          if (rows.length > 0) {

            const newRow =
              rows[0].cloneNode(true);

            // Reset values
            newRow.querySelector('select').value = '';
            newRow.querySelector('input').value = '';

            container.appendChild(newRow);

          }

        });


      // =========================
      // REMOVE ROW
      // =========================
      function removeRow(button) {

        const container =
          document.getElementById('items-container');

        const rows =
          container.querySelectorAll('.item-row');

        if (rows.length > 1) {

          button.closest('.item-row').remove();

        } else {

          alert(
            "An invoice must contain at least one item."
          );

        }

      }


      // =========================
      // SALES FORM VALIDATION
      // =========================
      const salesForm =
        document.querySelector('form');

      salesForm.addEventListener(
        'submit',
        function(event) {

          // =========================
          // CUSTOMER NAME
          // =========================
          const customerName =
            document.querySelector(
              'input[name="customerName"]'
            ).value.trim();

          if (customerName.length < 3) {

            alert(
              'Customer name must be at least 3 characters.'
            );

            event.preventDefault();
            return;

          }

          // Only letters and spaces
          const nameRegex =
            /^[A-Za-z ]+$/;

          if (!nameRegex.test(customerName)) {

            alert(
              'Customer name should contain letters only.'
            );

            event.preventDefault();
            return;

          }


          // =========================
          // PHONE VALIDATION
          // =========================
          const customerContact =
            document.querySelector(
              'input[name="customerContact"]'
            ).value.trim();

          const ugandaPhoneRegex =
            /^(?:\+256|0)7[0-9]{8}$/;

          if (
            !ugandaPhoneRegex.test(customerContact)
          ) {

            alert(
              'Enter valid Ugandan number.\nUse +2567XXXXXXXX or 07XXXXXXXX'
            );

            event.preventDefault();
            return;

          }



          // DELIVERY DISTANCE
       
          const deliveryDistance =
            Number(
              document.querySelector(
                'input[name="deliveryDistance"]'
              ).value
            );

          if (
            isNaN(deliveryDistance) ||
            deliveryDistance < 0
          ) {

            alert(
              'Delivery distance cannot be negative.'
            );

            event.preventDefault();
            return;

          }


     
          // PRODUCT VALIDATION  
          const productSelects =
            document.querySelectorAll(
              'select[name="product"]'
            );

          const quantityInputs =
            document.querySelectorAll(
              'input[name="quantity"]'
            );

          for (let i = 0; i < productSelects.length; i++) {

            const product =
              productSelects[i].value;

            const quantity =
              Number(quantityInputs[i].value);

            // Product required
            if (!product) {

              alert(
                `Please select product on row ${i + 1}`
              );

              event.preventDefault();
              return;

            }

            // Quantity validation
            if (
              isNaN(quantity) ||
              quantity <= 0
            ) {

              alert(
                `Invalid quantity on row ${i + 1}`
              );

              event.preventDefault();
              return;

            }

          }


       
          // SUCCESS ACTION INDICATOR
          
          const submitButton =
            document.querySelector(
              'button[type="submit"]'
            );

          submitButton.disabled = true;

          submitButton.innerHTML =
            '<span class="spinner-border spinner-border-sm"></span> Saving Sale...';

        }
      );