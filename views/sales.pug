doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Sales - NYONDO Stock

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --brand-navy: #0f172a;
        --brand-orange: #f97316;
        --sidebar-hover: #1e293b;
        --light-bg: #f8fafc;
      }

      body {
        background-color: var(--light-bg);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
      }

      .sidebar {
        background-color: var(--brand-navy);
        min-height: 100vh;
        position: fixed;
        padding: 0;
      }

      .brand-logo {
        color: var(--brand-orange);
        font-weight: 800;
        font-size: 1.5rem;
        padding: 25px 20px;
        display: block;
        text-decoration: none;
      }

      .nav-link {
        color: #94a3b8 !important;
        padding: 15px 25px;
        font-weight: 500;
        transition: 0.3s;
      }

      .nav-link:hover {
        background-color: var(--sidebar-hover);
        color: #ffffff !important;
      }

      .nav-link.active {
        background-color: var(--sidebar-hover);
        color: #ffffff !important;
        border-left: 4px solid var(--brand-orange);
      }

      .main-content {
        margin-left: 16.666667%;
        padding: 40px;
      }

      .section-card {
        background: #ffffff;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        padding: 30px;
        margin-bottom: 30px;
      }

      .section-title {
        color: var(--brand-navy);
        font-weight: 700;
        border-bottom: 3px solid var(--brand-orange);
        padding-bottom: 8px;
        margin-bottom: 30px;
        display: inline-block;
      }

      .form-label {
        color: #475569;
        font-weight: 600;
        font-size: 0.9rem;
      }

      .form-control,
      .form-select {
        border: 1px solid #e2e8f0;
        padding: 10px;
        border-radius: 6px;
      }

      .btn-add-sale {
        background-color: var(--brand-navy);
        color: white;
        border: none;
        padding: 12px;
        font-weight: 700;
        border-radius: 6px;
        width: 100%;
        margin-top: 15px;
        transition: 0.3s;
      }

      .btn-add-sale:hover {
        background-color: var(--brand-orange);
      }

      .table thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
      }

      @media(max-width:768px){
        .sidebar {
          position: relative;
          min-height: auto;
        }

        .main-content {
          margin-left: 0;
          padding: 20px;
        }
      }

  body
    .container-fluid
      .row

        nav.col-md-2.sidebar.d-none.d-md-block
          a.brand-logo(href='/dashboard')
            | NYONDO STOCK

          .nav.flex-column.mt-2
            a.nav-link(href='/dashboard')
              i.bi.bi-speedometer2.me-2
              | Dashboard

            a.nav-link.active(href='/sales')
              i.bi.bi-cart-check.me-2
              | Sales

            a.nav-link(href='/logout')
              span.text-danger
                i.bi.bi-box-arrow-right.me-2
                | Logout

        main.col-md-10.main-content

          .section-card
            h4.section-title Record Sale

            form(action='/add-sales' method='POST')
              .row.g-3

                .col-md-4
                  label.form-label Product Name
                  select.form-select(name='product' required)
                    option(value='') Select Product
                    option(value='Cement iiN') Cement iiN
                    option(value='Cement iiiN') Cement iiiN
                    option(value='Iron Bars 10mm') Iron Bars 10mm
                    option(value='Iron Bars 12mm') Iron Bars 12mm
                    option(value='Iron Bars 16mm') Iron Bars 16mm
                    option(value='Nails Inch 1') Nails Inch 1
                    option(value='Nails Inch 2') Nails Inch 2
                    option(value='Nails Inch 3') Nails Inch 3
                    option(value='Nails Inch 4') Nails Inch 4
                    option(value='Nails Inch 5') Nails Inch 5
                    option(value='Wheelbarrows') Wheelbarrows
                    option(value='Wire Mesh') Wire Mesh
                    option(value='Barbed Wires') Barbed Wires
                    option(value='Iron Sheets') Iron Sheets

                .col-md-2
                  label.form-label Quantity
                  input.form-control(type='number' name='quantity' required)

                .col-md-3
                  label.form-label Unit Price (UGX)
                  input.form-control(type='number' name='unitPrice' required)

                .col-md-3
                  label.form-label Customer Name
                  input.form-control(type='text' name='customerName' required)

                .col-md-4
                  label.form-label Customer Contact
                  input.form-control(type='text' name='customerContact' required)

                .col-md-4
                  label.form-label Payment Method
                  select.form-select(name='paymentMethod' required)
                    option(value='Cash') Cash At Hand
                    option(value='Mobile Money') Mobile Money
                    option(value='credit') Credit

                .col-md-4
                  label.form-label Delivery Distance (KM)
                  input.form-control(type='number' name='deliveryDistance' required)

              button.btn.btn-add-sale(type='submit')
                i.bi.bi-plus-circle.me-2
                | Add Sale

          .section-card
            h4.section-title Sales Records

            .table-responsive
              table.table.table-hover.align-middle
                thead
                  tr
                    th Product
                    th Qty
                    th Unit Price
                    th Customer
                    th Contact
                    th Payment
                    th Distance
                    th Transport
                    th Total
                    th Date 
                    th Action

                tbody
                  if sales.length > 0
                    each sale in sales
                      tr
                        td= sale.product
                        td= sale.quantity
                        td UGX #{sale.unitPrice}
                        td= sale.customerName
                        td= sale.customerContact
                        td= sale.paymentMethod
                        td #{sale.deliveryDistance} KM

                        td
                          if sale.transportFee === 0
                            span.badge.bg-success Free
                          else
                            span.badge.bg-warning.text-dark
                              | UGX #{sale.transportFee}

                        td.fw-bold
                          | UGX #{sale.total}

                        td
                          = new Date(sale.createdAt).toLocaleDateString()

                        td
                          .d-flex.gap-2
                            a.btn.btn-sm.btn-outline-dark(href='/edit-sales/' + sale._id)
                              i.bi.bi-pencil

                            a.btn.btn-sm.btn-danger(
                              href='/delete-sales/' + sale._id
                              onclick="return confirm('Delete this sales item?')"
                            )
                              i.bi.bi-trash
                              
                            a.btn.btn-sm.btn-outline-primary(href='/receipt/' + sale._id)
                              i.bi.bi-receipt

                  else
                    tr
                      td.text-center.py-4(colspan='10')
                        | No sales records found.

    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )