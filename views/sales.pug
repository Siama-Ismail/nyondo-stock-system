doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sales - NYONDO Stock

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )
    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --brand-navy: #212529;       /* Deep Charcoal Base */
        --brand-orange: #0d9488;     /* Vibrant Teal Accent */
        --sidebar-hover: rgba(13, 148, 136, 0.15); /* Clean Translucent Teal Hover */
        --light-bg: #f1f3f5;         /* Polished Silver Background */
      }

      body {
        background-color: var(--light-bg);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        margin: 0;
      }

      .sidebar {
        background-color: var(--brand-navy);
        min-height: 100vh;
        position: fixed;
        border-right: 3px solid var(--brand-orange);
      }

      .brand-logo {
        color: #ffffff !important;
        font-weight: 800;
        font-size: 1.5rem;
        padding: 25px 20px;
        display: block;
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.1);
      }

      .nav-link {
        color: #caecf5 !important;
        opacity: 0.85;
        padding: 15px 25px;
        font-weight: 500;
        transition: all 0.2s ease;
      }

      .nav-link:hover {
        background-color: var(--sidebar-hover);
        color: #ffffff !important;
        opacity: 1;
      }

      .nav-link.active {
        background-color: rgba(13, 148, 136, 0.2);
        color: #ffffff !important;
        opacity: 1;
        border-left: 4px solid var(--brand-orange);
      }

      .main-content {
        margin-left: 16.666667%;
        padding: 40px;
      }

      .section-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        padding: 30px;
        margin-bottom: 30px;
        border: 1px solid #dee2e6;
      }

      .section-title {
        color: var(--brand-navy);
        font-weight: 800;
        border-bottom: 3px solid var(--brand-orange);
        display: inline-block;
        margin-bottom: 20px;
      }

      .btn-primary {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
        font-weight: 600;
      }

      .btn-primary:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      .btn-warning {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
        font-weight: 600;
      }
      .btn-warning:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      .btn-outline-primary {
        background-color: var(--brand-orange) !important;
        border-color: var(--brand-orange) !important;
        color: #ffffff !important;
      }
      .btn-outline-primary:hover {
        background-color: #0b7a70 !important;
        border-color: #0b7a70 !important;
      }

      .btn-danger {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
      }
      .btn-danger:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
      }

  body
    .container-fluid
      .row
        // SIDEBAR 
        nav.col-md-2.sidebar.d-none.d-md-block
          a.brand-logo(href='/dashboard')
            | NYONDO #[span(style="color: var(--brand-orange);") STOCK]
          .nav.flex-column.mt-2
            a.nav-link(href='/dashboard')
              i.bi.bi-speedometer2.me-2
              | Home 
            a.nav-link.active(href='/sales')
              i.bi.bi-cart-check.me-2
              | Sales
            a.nav-link(href='/logout')
              span.text-danger
                i.bi.bi-box-arrow-right.me-2
                | Logout

        // MAIN CONTENT 
        main.col-md-10.main-content
          // SALES FORM 
          .section-card
            h4.section-title Record Sale

            - const formCustomerName = customerName || ''
            - const formCustomerContact = customerContact || ''
            - const formPaymentMethod = paymentMethod || ''
            - const formDeliveryDistance = ownTransport ? 0 : (deliveryDistance || '')
            - const selectedProduct = Array.isArray(product) ? product[0] : product
            - const selectedQuantity = Array.isArray(quantity) ? quantity[0] : quantity

            if success
              - const successMessage = Array.isArray(success) ? success[0] : success
              .alert.alert-success.alert-dismissible.fade.show.shadow-sm.mb-4(role='alert')
                .d-flex.align-items-center
                  i.bi.bi-check-circle-fill.me-2.fs-5
                  strong= successMessage
                button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')

            form(action='/add-sales' method='POST' novalidate)
              h5.text-muted.mb-3.fs-6 Customer Information

              .row.g-3.mb-3
                .col-md-4
                  label.form-label Customer Name
                  input.form-control(
                    type='text' 
                    name='customerName' 
                    required 
                    value=formCustomerName
                    class=fieldErrors && fieldErrors.customerName ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.customerName
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.customerName

                .col-md-4
                  label.form-label Customer Contact
                  input.form-control(
                    type="tel" 
                    name="customerContact" 
                    id="customerPhoneInput" 
                    placeholder="+256700000000"
                    value=formCustomerContact
                    minlength="13"
                    maxlength="13" 
                    pattern="^\\+256[0-9]{9}$" 
                    title="Phone number must start with +256 followed by exactly 9 digits"
                    required
                    class=fieldErrors && fieldErrors.customerContact ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.customerContact
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.customerContact

                .col-md-4
                  label.form-label Payment Method
                  select.form-select(
                    name='paymentMethod' 
                    required
                    class=fieldErrors && fieldErrors.paymentMethod ? 'is-invalid' : ''
                  )
                    option(value='') Select payment method
                    option(value='Cash' selected=formPaymentMethod==='Cash') Cash At Hand
                    option(value='Mobile Money' selected=formPaymentMethod==='Mobile Money') Mobile Money
                    option(value='Bank' selected=formPaymentMethod==='Bank') Bank
                  if fieldErrors && fieldErrors.paymentMethod
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.paymentMethod
                   

              // TRANSPORT CONFIGURATION SECTION
              .row.g-3.mb-4
                .col-md-4
                  label.form-label Delivery Distance (KM)
                  input#deliveryDistanceInput.form-control(
                    type='number' 
                    name='deliveryDistance' 
                    min='0' 
                    required 
                    value=formDeliveryDistance 
                    disabled=ownTransport
                    class=fieldErrors && fieldErrors.deliveryDistance ? 'is-invalid' : ''
                  )
                  if fieldErrors && fieldErrors.deliveryDistance
                    .invalid-feedback.d-block
                      i.bi.bi-exclamation-circle.me-1
                      = fieldErrors.deliveryDistance

                .col-md-4.d-flex.align-items-end
                  .form-check.mb-2
                    input#ownTransportCheckbox.form-check-input(type='checkbox' name='ownTransport' checked=ownTransport)
                    label.form-check-label.fw-semibold.ms-1(for='ownTransportCheckbox' style='color: var(--brand-navy);')
                      | Customer providing own transport

                .col-md-4
                  label.form-label Calculated Transport Fee
                  .input-group
                    span.input-group-text.bg-light.fw-bold UGX
                    input#calculatedFeeDisplay.form-control.fw-bold(
                      type='text'
                      value='0'
                      readonly
                      style='color: var(--brand-orange); background-color: #f8f9fa;'
                    )

              h5.text-muted.mb-3.fs-6 Products Ordered

              // ITEM ROWS CONTAINER
              #items-container
                .row.g-3.item-row.mb-3
                  .col-md-8
                    label.form-label Product Name
                    select.form-select(
                      name='product' 
                      required
                      class=fieldErrors && fieldErrors.product ? 'is-invalid' : ''
                    )
                      option(value='') Select Product
                      if stocks && stocks.length
                        each stock in stocks
                          option(value=stock.productname data-price=stock.sellingPrice selected=(selectedProduct===stock.productname))
                            | #{stock.productname} - Qty Available: #{stock.quantity} [UGX #{stock.sellingPrice.toLocaleString()}]
                      else
                        option(value='') No stock available
                    if fieldErrors && fieldErrors.product
                      .invalid-feedback.d-block
                        i.bi.bi-exclamation-circle.me-1
                        = fieldErrors.product

                  .col-md-3
                    label.form-label Quantity
                    input.form-control(
                      type='number' 
                      name='quantity' 
                      min='1' 
                      required 
                      value=(selectedQuantity || '')
                      class=fieldErrors && fieldErrors.quantity ? 'is-invalid' : ''
                    )
                    if fieldErrors && fieldErrors.quantity
                      .invalid-feedback.d-block
                        i.bi.bi-exclamation-circle.me-1
                        = fieldErrors.quantity

                  .col-md-1.d-flex.align-items-end
                    button.btn.btn-outline-danger.w-100(type='button' onclick='removeRow(this)')
                      i.bi.bi-trash

              button.btn.btn-outline-secondary.btn-sm.mb-4(type='button' id='add-item-btn')
                i.bi.bi-plus.me-1
                | Add Another Item

              button.btn.btn-primary.w-100(type='submit')
                i.bi.bi-plus-circle.me-2
                | Add Sale & Print Receipt

          // SALES RECORDS VIEW TABLE
          .section-card
            h4.section-title Sales Records
            .table-responsive
              table.table.table-hover.align-middle
                thead
                  tr
                    th Customer
                    th Contact
                    th Items Ordered
                    th Distance
                    th Transport
                    th Grand Total
                    th Date
                    th Action
                tbody
                  if sales && sales.length > 0
                    each sale in sales
                      tr
                        td.fw-bold= sale.customerName
                        td= sale.customerContact
                        td
                          span.badge.bg-dark #{sale.items ? sale.items.length : 0} Item(s)
                        td
                          if sale.ownTransport
                            | N/A (Self-Pickup)
                          else
                            | #{sale.deliveryDistance} KM
                        td
                          if sale.transportFee === 0 || sale.ownTransport
                            span.badge.bg-success Free
                          else
                            span.badge.bg-warning.text-dark UGX #{sale.transportFee.toLocaleString()}
                        td.fw-bold.text-success UGX #{sale.total.toLocaleString()}
                        td= new Date(sale.createdAt).toLocaleDateString()
                        td
                          a.btn.btn-sm.btn-warning.me-1(href='/edit-sales/' + sale._id title='Edit Sale')
                            i.bi.bi-pencil-square
                          a.btn.btn-sm.btn-outline-primary.me-1(href='/receipt/' + sale._id title='Print Receipt')
                            i.bi.bi-receipt
                          a.btn.btn-sm.btn-danger(href='/delete-sales/' + sale._id onclick="return confirm('Delete this sale record?')" title='Delete Sale')
                            i.bi.bi-trash
                  else
                    tr
                      td.text-center.py-4(colspan='8') No sales records found.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
    script.
      function runInvoiceEvaluation() {
        const distanceInput = document.getElementById('deliveryDistanceInput');
        const selfTransportBox = document.getElementById('ownTransportCheckbox');
        const chargeDisplay = document.getElementById('calculatedFeeDisplay');

        if (selfTransportBox.checked) {
          distanceInput.disabled = true;
          distanceInput.value = '0';
          distanceInput.removeAttribute('required');
          chargeDisplay.value = '0';
          return;
        }

        distanceInput.disabled = false;
        distanceInput.setAttribute('required', 'required');

        const distance = parseFloat(distanceInput.value) || 0;
        let currentGrossSum = 0;
        const activeRows = document.querySelectorAll('.item-row');
        
        activeRows.forEach(row => {
          const selectEl = row.querySelector('select[name="product"]');
          const qtyInput = row.querySelector('input[name="quantity"]');
          
          if (selectEl && selectEl.selectedIndex > 0) {
            const chosenOption = selectEl.options[selectEl.selectedIndex];
            const itemPrice = parseFloat(chosenOption.getAttribute('data-price')) || 0;
            const itemQty = parseFloat(qtyInput.value) || 0;
            currentGrossSum += (itemPrice * itemQty);
          }
        });

        if (distance === 0 && currentGrossSum === 0) {
          chargeDisplay.value = '0';
        } else if (distance <= 10 && currentGrossSum >= 500000) {
          chargeDisplay.value = '0';
        } else {
          chargeDisplay.value = '30000';
        }
      }

      document.getElementById('deliveryDistanceInput').addEventListener('input', runInvoiceEvaluation);
      document.getElementById('ownTransportCheckbox').addEventListener('change', runInvoiceEvaluation);
      document.getElementById('items-container').addEventListener('input', runInvoiceEvaluation);
      document.getElementById('items-container').addEventListener('change', runInvoiceEvaluation);
      window.addEventListener('DOMContentLoaded', runInvoiceEvaluation);

      document.getElementById('add-item-btn').addEventListener('click', function() {
        const container = document.getElementById('items-container');
        const rows = container.querySelectorAll('.item-row');
        if (rows.length > 0) {
          const newRow = rows[0].cloneNode(true);
          newRow.querySelector('select').value = '';
          newRow.querySelector('input').value = '';
          container.appendChild(newRow);
          runInvoiceEvaluation();
        }
      });

      function removeRow(button) {
        const container = document.getElementById('items-container');
        const rows = container.querySelectorAll('.item-row');
        if (rows.length > 1) {
          button.closest('.item-row').remove();
          runInvoiceEvaluation();
        } else {
          alert("An invoice must contain at least one item.");
        }
      }

      document.querySelector('form').addEventListener('submit', function(event) {
        // Disable client-side alert popups — rely on server-side validation
        // Ensure delivery distance is enabled so server receives it
        const distanceInput = document.getElementById('deliveryDistanceInput');
        if (distanceInput) distanceInput.disabled = false;

        // Show a saving spinner and disable the submit button
        const submitButton = document.querySelector('button[type="submit"]');
        if (submitButton) {
          submitButton.disabled = true;
          submitButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving Sale...';
        }
        // Allow the form to submit normally and display server-side inline errors if any
      });

      // Autofocus first invalid field (server-side validation)
      window.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form');
        if (!form) return;
        const firstInvalid = form.querySelector('.is-invalid');
        if (firstInvalid) {
          try { firstInvalid.focus(); } catch (e) {}
          if (typeof firstInvalid.select === 'function') {
            try { firstInvalid.select(); } catch (e) {}
          }
        }
      });