doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')

    title Sales - NYONDO Stock

    link(
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css'
      rel='stylesheet'
    )

    link(
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css'
    )

    style.
      :root {
        --brand-navy: #111827; /* Matte Black */
        --brand-orange: #10B981; /* Emerald Green */
        --sidebar-hover: #1f2937; /* Menu hover background */
        --light-bg: #E5E7EB; /* Silver Gray */
      }

      body {
        background-color: var(--light-bg);
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
      }

      .sidebar {
        background-color: var(--brand-navy);
        min-height: 100vh;
        position: fixed;
      }

      .brand-logo {
        color: var(--brand-orange) !important;
        font-weight: 800;
        font-size: 1.5rem;
        padding: 25px 20px;
        display: block;
        text-decoration: none;
      }

      .nav-link {
        color: #94a3b8 !important;
        padding: 15px 25px;
      }

      .nav-link:hover,
      .nav-link.active {
        background-color: var(--sidebar-hover);
        color: #10B981 !important;
      }

      .main-content {
        margin-left: 16.666667%;
        padding: 40px;
      }

      .section-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        padding: 30px;
        margin-bottom: 30px;
        border: 1px solid #d1d5db;
      }

      .section-title {
        color: var(--brand-navy);
        font-weight: 700;
        border-bottom: 3px solid var(--brand-orange);
        display: inline-block;
        margin-bottom: 20px;
      }

      .btn-primary {
        background-color: #10B981 !important;
        border-color: #10B981 !important;
        color: #111827 !important;
        font-weight: 600;
      }
      .btn-primary:hover {
        background-color: #059669 !important;
        border-color: #059669 !important;
      }

  body
    .container-fluid
      .row

        // ================= SIDEBAR =================
        nav.col-md-2.sidebar.d-none.d-md-block
          a.brand-logo(href='/dashboard') NYONDO STOCK

          .nav.flex-column.mt-2
            a.nav-link(href='/dashboard')
              i.bi.bi-speedometer2.me-2
              | Dashboard

            a.nav-link.active(href='/sales')
              i.bi.bi-cart-check.me-2
              | Sales

            a.nav-link(href='/logout')
              span.text-danger
                i.bi.bi-box-arrow-right.me-2
                | Logout

        // ================= MAIN =================
        main.col-md-10.main-content

          // ================= FORM =================
          .section-card
            h4.section-title Record Sale

            form(action='/add-sales' method='POST')
              h5.text-muted.mb-3.fs-6 Customer Information
              .row.g-3.mb-4
                .col-md-4
                  label.form-label Customer Name
                  input.form-control(type='text' name='customerName' required)

                .col-md-4
                  label.form-label Customer Contact
                  input.form-control(type='text' name='customerContact' required)

                .col-md-4
                  label.form-label Payment Method
                  select.form-select(name='paymentMethod' required)
                    option(value='Cash') Cash At Hand
                    option(value='Mobile Money') Mobile Money
                    option(value='credit') Credit

                .col-md-4
                  label.form-label Delivery Distance (KM)
                  input.form-control(type='number' name='deliveryDistance' required)

              h5.text-muted.mb-3.fs-6 Products Ordered
              
              // Container where dynamic multi-item rows are injected
              #items-container
                .row.g-3.item-row.mb-3
                  .col-md-8
                    label.form-label Product Name
                    select.form-select(name='product' required)
                      option(value='') Select Product
                      if stocks && stocks.length
                        each stock in stocks
                          option(value=stock.productname) #{stock.productname} - Qty Available: #{stock.quantity} [UGX #{stock.sellingPrice.toLocaleString()}]
                      else
                        option(value='') No stock available

                  .col-md-3
                    label.form-label Quantity
                    input.form-control(type='number' name='quantity' min='1' required)

                  .col-md-1.d-flex.align-items-end
                    button.btn.btn-outline-danger.w-100(type='button' onclick='removeRow(this)')
                      i.bi.bi-trash

              button.btn.btn-outline-secondary.btn-sm.mb-4(type='button' id='add-item-btn')
                i.bi.bi-plus.me-1
                | Add Another Item

              button.btn.btn-primary.w-100(type='submit')
                i.bi.bi-plus-circle.me-2
                | Add Sale &amp; Print Receipt


          // ================= TABLE =================
          .section-card
            h4.section-title Sales Records

            .table-responsive
              table.table.table-hover.align-middle
                thead
                  tr
                    th Customer
                    th Contact
                    th Items Ordered
                    th Distance
                    th Transport
                    th Grand Total
                    th Date
                    th Action

                tbody
                  if sales && sales.length > 0
                    each sale in sales
                      tr
                        td.fw-bold= sale.customerName
                        td= sale.customerContact
                        td
                          span.badge.bg-dark #{sale.items ? sale.items.length : 0} Item(s)
                        td #{sale.deliveryDistance} KM

                        td
                          if sale.transportFee === 0
                            span.badge.bg-success Free
                          else
                            span.badge.bg-warning.text-dark
                              | UGX #{sale.transportFee.toLocaleString()}

                        td.fw-bold.text-success
                          | UGX #{sale.total.toLocaleString()}

                        td
                          = new Date(sale.createdAt).toLocaleDateString()

                        td
                          a.btn.btn-sm.btn-danger(
                            href='/delete-sales/' + sale._id
                            onclick="return confirm('Delete this sale record?')"
                          )
                            i.bi.bi-trash

                          a.btn.btn-sm.btn-outline-primary.ms-1(href='/receipt/' + sale._id)
                            i.bi.bi-receipt

                  else
                    tr
                      td.text-center.py-4(colspan='8')
                        | No sales records found.


    script(
      src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js'
    )
    
    script.
      // Dynamic row replication frontend script
      document.getElementById('add-item-btn').addEventListener('click', function() {
        const container = document.getElementById('items-container');
        const rows = container.querySelectorAll('.item-row');
        if (rows.length > 0) {
          const newRow = rows[0].cloneNode(true);
          
          // Reset form fields within the newly cloned block
          newRow.querySelector('select').value = '';
          newRow.querySelector('input').value = '';
          container.appendChild(newRow);
        }
      });

      function removeRow(button) {
        const container = document.getElementById('items-container');
        const rows = container.querySelectorAll('.item-row');
        if (rows.length > 1) {
          button.closest('.item-row').remove();
        } else {
          alert("An invoice must contain at least one item line.");
        }
      }